<% partial = local_assigns.fetch(:partial) %>
<% collection = local_assigns.fetch(:collection) %>
<% as = local_assigns.fetch(:as) %>
<% content = local_assigns.fetch(:content, true) %>
<% extras = local_assigns.fetch(:extras, {}) %>

<% cache [
        collection,
        collection.except(:offset, :limit, :order),
        partial,
        ActionView::Digestor.digest(
          name: lookup_context.find_template(partial, [], true).virtual_path,
          finder: lookup_context
        ),
        as,
        content,
        ActiveSupport::Cache.expand_cache_key(extras),
        Current.user_or_guest,
        I18n.locale,
        Time.zone.name,
        request.base_url,
        request.fullpath,
        request.user_agent
      ],
      expires_in: 1.hour do %>
  <% pagination = cached_pagination(collection) %>

  <div class="p text-gray-600">
    <%= page_entries_info(
      pagination,
      entry_name: collection.entry_name(count: pagination.size).downcase
    ) %>
  </div>

  <% if content %>
    <%= render(partial:, collection:, as:, **extras) %>

    <% if pagination.total_pages > 1 %>
      <div class="p p--flex"><%= paginate(pagination) %></div>
    <% end %>
  <% end %>
<% end %>
