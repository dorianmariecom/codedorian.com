<% content_for(:title, @job_pause) %>

<%= turbo_stream_from(@job_pause) %>

<%= render("shared/attribute", label: t(".id"), value: @job_pause.id) %>

<%= render(
  "shared/attribute",
  label: t(".queue_name"),
  value: @job_pause.queue_name
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_pause.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_pause.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, job_pause_id: @job_pause&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_pause_id: @job_pause&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_pause]
    }
  ) %>
<% end %>
