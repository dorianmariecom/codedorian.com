<% if can?(:create, JobContext) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_contexts.any? &&
    (can?(:destroy_all, JobContext) || can?(:delete_all, JobContext)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobContext) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobContext) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_contexts/job_context",
    collection: @job_contexts,
    as: :job_context
  ) %>
</turbo-frame>
