<%= turbo_stream_from(@data) %>

<% if can?(:create, Datum) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @data.any? && (can?(:destroy_all, Datum) || can?(:delete_all, Datum)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Datum) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Datum) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "data/datum", collection: @data, as: :datum) %>
</turbo-frame>
