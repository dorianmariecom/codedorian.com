<% content_for(:title, @solid_cache_entry) %>

<%= turbo_stream_from(@solid_cache_entry) %>

<%= render("shared/attribute", label: t(".id"), value: @solid_cache_entry.id) %>

<%= render(
  "shared/attribute",
  label: t(".key_hash"),
  value: @solid_cache_entry.key_hash
) %>

<%= render(
  "shared/attribute",
  label: t(".byte_size"),
  value: @solid_cache_entry.byte_size
) %>

<%= render(
  "shared/attribute",
  label: t(".key_base64"),
  value: @solid_cache_entry.key_base64
) %>

<%= render(
  "shared/attribute",
  label: t(".value_base64"),
  value: @solid_cache_entry.value_base64
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @solid_cache_entry.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>
