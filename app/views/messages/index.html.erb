<%= turbo_stream_from(@messages) %>

<% unless simple? %>
  <% if can?(:create, Message) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>

  <%= render("shared/search") %>
<% end %>

<turbo-frame id="search" target="_top">
  <% if @messages.any? && (can?(:destroy_all, Message) || can?(:delete_all, Message)) &&
    !simple? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Message) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Message) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "messages/message",
    collection: @messages,
    as: :message
  ) %>
</turbo-frame>
