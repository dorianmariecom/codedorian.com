<% content_for(:title, @message) %>

<%= turbo_stream_from(@message) %>

<% if simple? %>
  <% if @message.subject.present? %>
    <div class="p">
      <div class="font-bold"><%= @message.subject %></div>
    </div>
  <% end %>

  <% if @message.body.present? %>
    <div class="p"><%= @message.body %></div>
  <% end %>
<% else %>
  <%= render("shared/attribute", label: t(".id"), value: @message.id) %>

  <%= render(
    "shared/attribute",
    label: t(".from_user"),
    value: @message.from_user,
    type: :record
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".to_user"),
    value: @message.to_user,
    type: :record
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".subject"),
    value: @message.subject,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".body"),
    value: @message.body,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @message.updated_at,
    type: :time
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @message.created_at,
    type: :time
  ) %>

  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>

  <% if can?(:index, Job) %>
    <% jobs =
      policy_scope(Job)
        .where_message(@message)
        .order(created_at: :desc)
        .page(params[:page]) %>

    <div class="p font-bold">
      <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
    </div>

    <% if can?(:create, Job) %>
      <div class="p">
        <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "jobs/job",
      collection: jobs,
      as: :job,
      locals: {
        nested: jobs_nested
      }
    ) %>
  <% end %>

  <% if can?(:index, Version) %>
    <div class="p font-bold">
      <%= link_to(
        t(".versions"),
        { controller: :versions, action: :index, message_id: @message&.id },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          { controller: :versions, action: :new, message_id: @message&.id },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: [*nested, @message]
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold">
      <%= link_to(
        t(".logs"),
        { controller: :logs, action: :index, message_id: @message&.id },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          { controller: :logs, action: :new, message_id: @message&.id },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: [*nested, @message]
      }
    ) %>
  <% end %>
<% end %>
