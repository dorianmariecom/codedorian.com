<% content_for(:title, @version) %>

<%= turbo_stream_from(@version) %>

<%= render("shared/attribute", label: t(".id"), value: @version.id) %>

<%= render("shared/attribute", label: t(".event"), value: @version.event) %>

<%= render("shared/attribute", label: t(".item_type"), value: @version.item_type) %>

<%= render("shared/attribute", label: t(".item_id"), value: @version.item_id) %>

<%= render("shared/attribute", label: t(".whodunnit"), value: @version.whodunnit) %>

<%= render(
  "shared/attribute",
  label: t(".object"),
  value: @version.object_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".object_changes"),
  value: @version.object_changes_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @version.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @version.created_at,
  type: :time
) %>

<% if can?(:update, @version) || can?(:destroy, @version) %>
  <div class="p">
    <% if can?(:update, @version) %>
      <%= link_to(t(".edit"), edit_url, class: :link) %>
    <% end %>
    <% if can?(:destroy, @version) %>
      <%= render("shared/confirm", url: destroy_url, text: t(".destroy"), class: :link) %>
      <%= render("shared/confirm", url: delete_url, text: t(".delete"), class: :link) %>
    <% end %>
  </div>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, version_id: @version.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "logs/log",
    collection:
      policy_scope(Log)
        .where_version(@version)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
