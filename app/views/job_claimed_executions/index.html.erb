<%= turbo_stream_from(@job_claimed_executions) %>

<% if can?(:index, JobContext) %>
  <%
    records = policy_scope(JobContext)
    if @job
      records = records.where_job(@job)
    elsif @program
      records = records.where_program(@program)
    elsif @user
      records = records.where_user(@user)
    elsif @guest
      records = records.where_guest(@guest)
    end
    records = records.where_job_batch(@job_batch) if @job_batch
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "job_contexts",
    url: {
      controller: :job_contexts,
      action: :index,
      guest_id: @guest&.id,
      job_id: @job&.id,
      job_batch_id: @job_batch&.id,
      program_id: @program&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <%
    records = policy_scope(Log)
    records = records.where_guest(@guest) if @guest
    records = records.where_job(@job) if @job
    records = records.where_job_batch(@job_batch) if @job_batch
    records = records.where_job_process(@job_process) if @job_process
    records = records.where_program(@program) if @program
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "logs",
    url: {
      controller: :logs,
      action: :index,
      guest_id: @guest&.id,
      job_id: @job&.id,
      job_batch_id: @job_batch&.id,
      job_process_id: @job_process&.id,
      program_id: @program&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>

<% if can?(:create, JobClaimedExecution) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_claimed_executions.any? &&
    (
      can?(:destroy_all, JobClaimedExecution) ||
        can?(:delete_all, JobClaimedExecution)
    ) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobClaimedExecution) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobClaimedExecution) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_claimed_executions/job_claimed_execution",
    collection: @job_claimed_executions,
    as: :job_claimed_execution
  ) %>
</turbo-frame>
