<% content_for(:title, @service_field) %>
<% content_for(:description, @service_field.name) %>
<%= turbo_stream_from(@service_field) %>
<%= render("shared/attribute", label: t(".id"), value: @service_field.id) %>
<%= render(
  "shared/attribute",
  label: t(".service_id"),
  value: @service_field.service,
  type: :record
) %>
<%= render("shared/attribute", label: t(".key"), value: @service_field.key) %>
<%= render(
  "shared/attribute",
  label: t(".name_en"),
  value: @service_field.name_en,
  type: :content
) %>
<%= render(
  "shared/attribute",
  label: t(".name_fr"),
  value: @service_field.name_fr,
  type: :content
) %>
<%= render("shared/attribute", label: t(".kind"), value: @service_field.kind) %>
<%= render(
  "shared/attribute",
  label: t(".required"),
  value: @service_field.required?
) %>
<%= render(
  "shared/attribute",
  label: t(".position"),
  value: @service_field.position
) %>
<div class="p p--flex">
  <% if can?(:update, @service_field) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @service_field) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        { controller: :versions, action: :new, service_field_id: @service_field.id },
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, service_field_id: @service_field.id },
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
