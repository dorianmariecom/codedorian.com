<% content_for(:title, @service_field) %>
<% content_for(:description, @service_field.name) %>
<%= turbo_stream_from(@service_field) %>
<% if @service_field.id.present? %><div class="p"><div class="text-gray-600"><%= t(".id") %></div><div class="font-bold"><%= @service_field.id %></div></div><% end %>
<% if @service_field.service_id.present? %><div class="p"><div class="text-gray-600"><%= t(".service_id") %></div><div class="font-bold"><%= link_to_if(can?(:show, @service_field.service), @service_field.service, @service_field.service, class: :link) %></div></div><% end %>
<% if @service_field.key.present? %><div class="p"><div class="text-gray-600"><%= t(".key") %></div><div class="font-bold"><%= @service_field.key %></div></div><% end %>
<% if @service_field.name_en.present? %><div class="p"><div class="text-gray-600"><%= t(".name_en") %></div><%= @service_field.name_en %></div><% end %>
<% if @service_field.name_fr.present? %><div class="p"><div class="text-gray-600"><%= t(".name_fr") %></div><%= @service_field.name_fr %></div><% end %>
<% if @service_field.kind.present? %><div class="p"><div class="text-gray-600"><%= t(".kind") %></div><div class="font-bold"><%= @service_field.kind %></div></div><% end %>
<div class="p"><div class="text-gray-600"><%= t(".required") %></div><div class="font-bold"><%= @service_field.required? %></div></div>
<% if @service_field.position.present? %><div class="p"><div class="text-gray-600"><%= t(".position") %></div><div class="font-bold"><%= @service_field.position %></div></div><% end %>
<div class="p p--flex">
  <% if can?(:update, @service_field) %><%= link_to(t(".edit"), edit_url, class: :link) %><% end %>
  <% if can?(:destroy, @service_field) %><%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %><%= render("shared/confirm", text: t(".delete"), url: delete_url) %><% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <% if can?(:create, Version) %><div class="p"><%= link_to(t(".new_version"), { controller: :versions, action: :new, service_field_id: @service_field.id }, class: "button") %></div><% end %>
  <%= render_collection(partial: "versions/version", collection: @versions, as: :version, locals: { nested: [] }) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <% if can?(:create, Log) %><div class="p"><%= link_to(t(".new_log"), { controller: :logs, action: :new, service_field_id: @service_field.id }, class: "button") %></div><% end %>
  <%= render_collection(partial: "logs/log", collection: @logs, as: :log, locals: { nested: [] }) %>
<% end %>
