<div class="service-field border-l border-black pl-5" data-new-record="<%= f.object.new_record? %>">
  <%= f.hidden_field(:id, autocomplete: :off, data: { form_type: :other }) %>
  <%= f.hidden_field(:_destroy, autocomplete: :off, data: { form_type: :other }) %>
  <h2 class="font-bold p"><%= ServiceField.model_name.human %></h2>
  <div class="p"><%= f.label(:key, class: :label) %><%= f.text_field(:key, required: true, class: :input, autocomplete: :off) %></div>
  <div class="p"><%= f.label(:name_en, class: :label) %><%= f.rich_textarea(:name_en, class: :input, required: true, autocomplete: :off, data: { form_type: :other }) %></div>
  <div class="p"><%= f.label(:name_fr, class: :label) %><%= f.rich_textarea(:name_fr, class: :input, required: true, autocomplete: :off, data: { form_type: :other }) %></div>
  <div class="p"><%= f.label(:kind, class: :label) %><%= f.select(:kind, ServiceField::KINDS, {}, required: true, class: :input, autocomplete: :off) %></div>
  <div class="p"><%= f.label(:required, class: :label) %><%= f.check_box(:required, autocomplete: :off, data: { form_type: :other }) %></div>
  <div class="p"><%= f.label(:position, class: :label) %><%= f.number_field(:position, required: true, min: 0, class: :input, autocomplete: :off) %></div>
  <div class="p"><button class="link" data-action="nested#remove"><%= t("plan_schedules.nested_form.remove") %></button></div>
</div>
