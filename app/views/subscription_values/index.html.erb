<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@subscription_values) %>

<% if can?(:index, Version) %>
  <%
    records = policy_scope(Version)
    records = records.where_plan(@plan) if @plan
    records = records.where_service(@service) if @service
    records = records.where_subscription(@subscription) if @subscription
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "versions",
    url: {
      controller: :versions,
      action: :index,
      plan_id: @plan&.id,
      service_id: @service&.id,
      subscription_id: @subscription&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <%
    records = policy_scope(Log)
    records = records.where_plan(@plan) if @plan
    records = records.where_service(@service) if @service
    records = records.where_subscription(@subscription) if @subscription
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "logs",
    url: {
      controller: :logs,
      action: :index,
      plan_id: @plan&.id,
      service_id: @service&.id,
      subscription_id: @subscription&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>

<% if can?(:create, SubscriptionValue) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @subscription_values.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, SubscriptionValue) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, SubscriptionValue) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_values/subscription_value",
    collection: @subscription_values,
    as: :subscription_value
  ) %>
</turbo-frame>
