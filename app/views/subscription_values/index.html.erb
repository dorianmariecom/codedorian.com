<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@subscription_values) %>
<% if can?(:create, SubscriptionValue) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @subscription_values.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, SubscriptionValue) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, SubscriptionValue) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_values/subscription_value",
    collection: @subscription_values,
    as: :subscription_value
  ) %>
</turbo-frame>
