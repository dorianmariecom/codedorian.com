<% content_for(:title, @subscription_value) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_value) %>

<%= render("shared/attribute", label: t(".id"), value: @subscription_value.id) %>

<%= render(
  "shared/attribute",
  label: t(".subscription_id"),
  value: @subscription_value.subscription,
  type: :record
) %>

<%= render("shared/attribute", label: t(".key"), value: @subscription_value.key) %>

<%= render("shared/attribute", label: t(".value"), value: @subscription_value.value) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @subscription_value.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @subscription_value.created_at,
  type: :time
) %>

<% if can?(:update, @subscription_value) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <% if can?(:destroy, @subscription_value) %>
      <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
      <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
    <% end %>
  </div>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        subscription_value_id: @subscription_value.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "versions/version",
    collection:
      policy_scope(Version)
        .where_subscription_value(@subscription_value)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        subscription_value_id: @subscription_value.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "logs/log",
    collection:
      policy_scope(Log)
        .where_subscription_value(@subscription_value)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
