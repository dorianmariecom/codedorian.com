<% content_for(:title, @subscription_value) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_value) %>

<%= render("shared/attribute", label: t(".id"), value: @subscription_value.id) %>

<%= render(
  "shared/attribute",
  label: t(".subscription_id"),
  value: @subscription_value.subscription,
  type: :record
) %>

<%= render("shared/attribute", label: t(".key"), value: @subscription_value.key) %>

<%= render("shared/attribute", label: t(".value"), value: @subscription_value.value) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @subscription_value.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @subscription_value.created_at,
  type: :time
) %>

<% if can?(:update, @subscription_value) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <% if can?(:destroy, @subscription_value) %>
      <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
      <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
    <% end %>
  </div>
<% end %>
