<% content_for(:title, @subscription_value) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_value) %>

<% if @subscription_value.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @subscription_value.id %></div>
  </div>
<% end %>

<% if @subscription_value.subscription_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".subscription_id") %></div>
    <div class="font-bold">
      <%= link_to(
        @subscription_value.subscription,
        @subscription_value.subscription,
        class: :link
      ) %>
    </div>
  </div>
<% end %>

<% if @subscription_value.key.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".key") %></div>
    <div class="font-bold"><%= @subscription_value.key %></div>
  </div>
<% end %>

<% if @subscription_value.value.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".value") %></div>
    <div class="font-bold"><%= @subscription_value.value %></div>
  </div>
<% end %>

<% if @subscription_value.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription_value.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription_value.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription_value.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if can?(:update, @subscription_value) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <% if can?(:destroy, @subscription_value) %>
      <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
      <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
    <% end %>
  </div>
<% end %>
