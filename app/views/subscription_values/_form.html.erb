<%= form_for(show_url) do |f| %>
  <% if admin? %>
    <div class="p">
      <%= f.label(:subscription_id, class: :label) %>
      <%= f.select(
        :subscription_id,
        policy_scope(Subscription).order(:id).map { |record| [record.to_s, record.id] },
        {},
        required: true,
        class: :input,
        autocomplete: :off
      ) %>
    </div>
  <% else %>
    <%= f.hidden_field(:subscription_id, autocomplete: :off) %>
  <% end %>
  <div class="p">
    <%= f.label(:key, class: :label) %>
    <%= f.text_field(:key, required: true, class: :input, autocomplete: :off) %>
  </div>
  <div class="p">
    <%= f.label(:value, class: :label) %>
    <%= f.text_field(:value, class: :input, autocomplete: :off) %>
  </div>
  <div class="p">
    <%= f.submit(
      submit,
      class: "button",
      data: {
        controller: "bridge--button",
        bridge__button_title_value: submit
      }
    ) %>
  </div>
<% end %>
