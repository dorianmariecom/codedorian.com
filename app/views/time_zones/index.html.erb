<%= turbo_stream_from(@time_zones) %>

<% if can?(:create, TimeZone) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @time_zones.any? &&
    (can?(:destroy_all, TimeZone) || can?(:delete_all, TimeZone)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, TimeZone) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, TimeZone) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "time_zones/time_zone",
    collection: @time_zones,
    as: :time_zone
  ) %>
</turbo-frame>
