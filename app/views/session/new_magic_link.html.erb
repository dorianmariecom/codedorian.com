<%= form_for(:session, url: request_magic_link_login_path) do |f| %>
  <%= hidden_field_tag(:redirect_to, params[:redirect_to], autocomplete: :off) %>
  <div class="p">
    <%= f.label(:email_address, class: :label) %>
    <%= f.email_field(
      :email_address,
      value: email_address_param,
      class: :input,
      required: true,
      autocomplete: :email
    ) %>
  </div>
  <div class="p">
    <%= f.submit(
      t(".submit"),
      class: :button,
      data: {
        controller: "bridge--button",
        bridge__button_title_value: t(".submit")
      }
    ) %>
  </div>
<% end %>
<div class="p">
  <%= link_to(
    t(".password"),
    new_login_path(plan_id: params[:plan_id], redirect_to: params[:redirect_to]),
    class: :link
  ) %>
</div>
