<%= turbo_stream_from(@solid_cable_messages) %>

<% if can?(:create, SolidCableMessage) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @solid_cable_messages.any? &&
    (
      can?(:destroy_all, SolidCableMessage) ||
        can?(:delete_all, SolidCableMessage)
    ) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, SolidCableMessage) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, SolidCableMessage) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "solid_cable_messages/solid_cable_message",
    collection: @solid_cable_messages,
    as: :solid_cable_message
  ) %>
</turbo-frame>
