<% content_for(:title, @solid_cable_message) %>

<%= turbo_stream_from(@solid_cable_message) %>

<%= render("shared/attribute", label: t(".id"), value: @solid_cable_message.id) %>

<%= render(
  "shared/attribute",
  label: t(".channel"),
  value: binary_text(@solid_cable_message.channel)
) %>
<%= render(
  "shared/attribute",
  label: t(".channel_hex"),
  value: binary_hex(@solid_cable_message.channel),
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".channel_hash"),
  value: @solid_cable_message.channel_hash
) %>

<%= render(
  "shared/attribute",
  label: t(".payload"),
  value: binary_text(@solid_cable_message.payload)
) %>
<%= render(
  "shared/attribute",
  label: t(".payload_hex"),
  value: binary_hex(@solid_cable_message.payload),
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @solid_cable_message.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>
