<% content_for(:title, t(".title")) %>
<p class="p"><%= t(".description") %></p>
<% MailboxOauth::PROVIDERS.each do |provider| %>
  <div class="p">
    <% if MailboxOauth.new(provider).configured? %>
      <%= button_to t(".connect", provider: t("delivery_connections.model.providers.#{provider}")), mailbox_connections_path(provider: provider), class: :button, data: { turbo: false } %>
    <% else %>
      <p><%= t(".unavailable", provider: t("delivery_connections.model.providers.#{provider}")) %></p>
    <% end %>
  </div>
<% end %>
<% @connections.each do |connection| %>
  <div class="p">
    <%= link_to connection.name, delivery_connection_path(connection), class: :link %>
    <p><%= connection.ready? ? t(".connected") : t(".disconnected") %></p>
    <% if connection.enabled? %>
      <%= button_to t(".disconnect"), mailbox_connection_path(connection), method: :delete, class: :link %>
    <% end %>
  </div>
<% end %>
<%= paginate @connections %>
