<%= turbo_stream_from(@program_schedules) %>

<% if can?(:create, ProgramSchedule) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @program_schedules.any? &&
    (can?(:destroy_all, ProgramSchedule) || can?(:delete_all, ProgramSchedule)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, ProgramSchedule) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, ProgramSchedule) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "program_schedules/program_schedule",
    collection: @program_schedules,
    as: :program_schedule
  ) %>
</turbo-frame>
