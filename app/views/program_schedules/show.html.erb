<% content_for(:title, @program_schedule) %>

<%= turbo_stream_from(@program_schedule) %>

<%= render("shared/attribute", label: t(".id"), value: @program_schedule.id) %>

<%= render(
  "shared/attribute",
  label: t(".user"),
  value: @program_schedule.user,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".program"),
  value: @program_schedule.program,
  type: :record,
  url: [@user, @program_schedule.program]
) %>

<%= render(
  "shared/attribute",
  label: t(".starts_at"),
  value: @program_schedule.starts_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".interval"),
  value: @program_schedule.translated_interval
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @program_schedule.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @program_schedule.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_program_schedule(@program_schedule)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(
      t(".jobs"),
      {
        controller: :jobs,
        action: :index,
        program_schedule_id: @program_schedule.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        program_schedule_id: @program_schedule.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        {
          controller: :versions,
          action: :new,
          user_id: @user&.id,
          guest_id: @guest&.id,
          program_id: @program&.id,
          program_schedule_id: @program_schedule.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @program_schedule]
    }
  ) %>
<% end %>

