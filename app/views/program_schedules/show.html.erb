<% if can?(:index, JobContext) %>
  <div class="p font-bold">
    <%= link_to(
      t(".job_contexts"),
      {
        controller: :job_contexts,
        action: :index,
        program_schedule_id: @program_schedule.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "job_contexts/job_context",
    collection:
      policy_scope(JobContext)
        .where_program_schedule(@program_schedule)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job_context,
    locals: {
      nested: []
    }
  ) %>
<% end %>

