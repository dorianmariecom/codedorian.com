<div class="p">
  <% parents = nested.compact %>
  <% identity = parents.first if parents.first.is_a?(User) || parents.first.is_a?(Guest) %>
  <% query = (parents - [identity]).to_h { |parent| ["#{parent.model_name.singular_route_key}_id", parent.to_param] } %>
  <%= link_to([identity, program_schedule, **query].compact, class: :link) do %>
    <% if program_schedule.once? %>
      <%= t(
        ".schedule_once_html",
        local_time: local_time(program_schedule.starts_at, format: :default),
        interval: program_schedule.translated_interval
      ) %>
    <% else %>
      <%= t(
        ".schedule_html",
        local_time: local_time(program_schedule.starts_at, format: :default),
        interval: program_schedule.translated_interval
      ) %>
    <% end %>
  <% end %>
</div>
