<% if can?(:create, Device) && !simple? %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @devices.any? && (can?(:destroy_all, Device) || can?(:delete_all, Device)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Device) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Device) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "devices/device", collection: @devices, as: :device) %>
</turbo-frame>
