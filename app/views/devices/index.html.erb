<%= turbo_stream_from(@devices) %>

<% if can?(:index, Job) %>
  <%
    records = policy_scope(Job)
    if @user
      records = records.where_user(@user)
    elsif @guest
      records = records.where_guest(@guest)
    end
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "jobs",
    url: {
      controller: :jobs,
      action: :index,
      guest_id: @guest&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
