<% content_for(:title, @device) %>

<%= turbo_stream_from(@device) %>

<%= render("shared/attribute", label: t(".id"), value: @device.id) %>

<%= render(
  "shared/attribute",
  label: t(".user"),
  value: @device.user,
  type: :record
) %>

<%= render("shared/attribute", label: t(".platform"), value: @device.platform) %>

<%= render("shared/attribute", label: t(".token"), value: @device.token) %>

<%= render("shared/attribute", label: t(".primary"), value: @device.primary?) %>

<% if admin? %>
  <%= render("shared/attribute", label: t(".verified"), value: @device.verified?) %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @device.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @device.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_device(@device)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(
      t(".jobs"),
      { controller: :jobs, action: :index, device_id: @device.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      { controller: :versions, action: :index, device_id: @device.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        { controller: :versions, action: :new, device_id: @device&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @device]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
