<% if can?(:index, JobContext) %>
  <div class="p font-bold">
    <%= link_to(
      t(".job_contexts"),
      { controller: :job_contexts, action: :index, device_id: @device.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "job_contexts/job_context",
    collection:
      policy_scope(JobContext)
        .where_device(@device)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job_context,
    locals: {
      nested: []
    }
  ) %>
<% end %>

