<% content_for(:title, @stripe_invoice) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@stripe_invoice) %>

<%= render(
  "shared/attribute",
  label: t(".subscription"),
  value: @stripe_invoice.subscription,
  type: :record
) %>

<% %i[
  id
  stripe_invoice_id
  stripe_payment_intent_id
  number
  status
  currency
  amount_due
  amount_paid
].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @stripe_invoice.public_send(attribute)
  ) %>
<% end %>

<% %i[period_start period_end paid_at updated_at created_at].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @stripe_invoice.public_send(attribute),
    type: :time
  ) %>
<% end %>

<% %i[hosted_invoice_url invoice_pdf].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @stripe_invoice.public_send(attribute),
    type: :link
  ) %>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
