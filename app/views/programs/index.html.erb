<%= turbo_stream_from(@programs) %>

<% if can?(:index, ProgramSchedule) %>
  <%
    records = policy_scope(ProgramSchedule)
    records = records.where_guest(@guest) if @guest
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "program_schedules",
    url: {
      controller: :program_schedules,
      action: :index,
      guest_id: @guest&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
