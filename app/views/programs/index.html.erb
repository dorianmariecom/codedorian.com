<%= turbo_stream_from(@programs) %>

<div class="p">
  <%= link_to(t(".data", count: @data.size), [@user || @guest, :data], class: :link) %>
</div>

<% if @program_executions.any? %>
  <div class="p p--flex">
    <%= link_to(
      t(".program_executions", count: @program_executions.size),
      {
        controller: :program_executions,
        action: :index,
        user_id: @user&.id,
        guest_id: @guest&.id
      },
      class: :link
    ) %>
  </div>
<% end %>

<% if @program_schedules.any? %>
  <div class="p p--flex">
    <%= link_to(
      t(".program_schedules", count: @program_schedules.size),
      {
        controller: :program_schedules,
        action: :index,
        user_id: @user&.id,
        guest_id: @guest&.id
      },
      class: :link
    ) %>
  </div>
<% end %>

<% if can?(:create, Program) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @programs.any? %>
    <div class="p p--flex">
      <%= render(
        "shared/confirm",
        url: [:format_all, *index_url],
        text: t(".format_all"),
        method: :post
      ) %>
      <%= render(
        "shared/confirm",
        url: [:schedule_all, *index_url],
        text: t(".schedule_all"),
        method: :patch
      ) %>
      <%= render(
        "shared/confirm",
        url: [:unschedule_all, *index_url],
        text: t(".unschedule_all"),
        method: :patch
      ) %>
      <% if can?(:destroy_all, Program) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Program) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "programs/program",
    collection: @programs,
    as: :program
  ) %>
</turbo-frame>
