    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        {
          controller: :versions,
          action: :new,
          user_id: @user&.id,
          program_id: @program.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
