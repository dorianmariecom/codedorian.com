<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        user_id: @user&.id,
        program_id: @program.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
