<% content_for(:title, @program) %>

<%= turbo_stream_from(@program) %>

<%= render("shared/attribute", label: t(".id"), value: @program.id) %>

<%= render(
  "shared/attribute",
  label: t(".user"),
  value: @program.user,
  type: :record
) %>

<%= render("shared/attribute", label: t(".name"), value: @program.name) %>

<%= render(
  "shared/attribute",
  label: t(".input"),
  value: @program.input,
  type: :code,
  url: can?(:update, @program) ? edit_url : nil
) %>

<%= render("shared/attribute", label: t(".scheduled"), value: @program.scheduled) %>

<%= render(
  "shared/attribute",
  label: t(".starts_at"),
  value: @program.starts_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".previous_at"),
  value: @program.previous_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".next_at"),
  value: @program.next_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @program.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @program.created_at,
  type: :time
) %>

<% if @program.scheduled? %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".unschedule"),
      url: [:unschedule, *show_url],
      method: :post
    ) %>
  </div>
<% else %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".schedule"),
      url: [:schedule, *show_url],
      method: :post
    ) %>
  </div>
<% end %>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".format"),
    url: [:format, *show_url],
    method: :post,
    class: "button"
  ) %>
</div>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".evaluate"),
    url: [:evaluate, *show_url],
    method: :post,
    class: "button"
  ) %>
</div>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_program(@program)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(
      t(".jobs"),
      {
        controller: :jobs,
        action: :index,
        user_id: @user&.id,
        guest_id: @guest&.id,
        program_id: @program.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(
        t(".new_job"),
        {
          controller: :jobs,
          action: :new,
          user_id: @user&.id,
          guest_id: @guest&.id,
          program_id: @program.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".program_schedules"),
    {
      controller: :program_schedules,
      action: :index,
      user_id: @user&.id,
      program_id: @program.id
    },
    class: :link
  ) %>
</div>

<% if can?(:create, ProgramSchedule) %>
  <div class="p">
    <%= link_to(
      t(".new_program_schedule"),
      {
        controller: :program_schedules,
        action: :new,
        user_id: @user&.id,
        program_id: @program.id
      },
      class: "button"
    ) %>
  </div>
<% end %>

<%= render_collection(
  partial: "program_schedules/program_schedule",
  collection: @program_schedules,
  as: :program_schedule,
  locals: {
    nested: [@user, @program]
  }
) %>

<div class="p font-bold">
