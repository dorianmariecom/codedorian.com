<% content_for(:title, @program) %>

<%= turbo_stream_from(@program) %>

<% if @program.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @program.id %></div>
  </div>
<% end %>

<% if @program.user.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".user") %></div>
    <%= render("shared/user", user: @program.user) %>
  </div>
<% end %>

<% if @program.name.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".name") %></div>
    <div class="font-bold"><%= @program.name %></div>
  </div>
<% end %>

<% if @program.input.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".input") %></div>
    <%= code_highlight(@program.input) %>
  </div>
<% end %>

<% if @program.scheduled.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".scheduled") %></div>
    <div class="font-bold"><%= @program.scheduled %></div>
  </div>
<% end %>

<% if @program.starts_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".starts_at") %></div>
    <div class="font-bold">
      <%= local_time(@program.starts_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @program.previous_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".previous_at") %></div>
    <div class="font-bold">
      <%= local_time(@program.previous_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @program.next_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".next_at") %></div>
    <div class="font-bold">
      <%= local_time(@program.next_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @program.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@program.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @program.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@program.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @program.scheduled? %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".unschedule"),
      url: [:unschedule, *show_url],
      method: :post
    ) %>
  </div>
<% else %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".schedule"),
      url: [:schedule, *show_url],
      method: :post
    ) %>
  </div>
<% end %>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".format"),
    url: [:format, *show_url],
    method: :post,
    class: "button"
  ) %>
</div>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".evaluate"),
    url: [:evaluate, *show_url],
    method: :post,
    class: "button"
  ) %>
</div>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_program(@program)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(
      t(".jobs"),
      {
        controller: :jobs,
        action: :index,
        user_id: @user&.id,
        guest_id: @guest&.id,
        program_id: @program.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(
        t(".new_job"),
        {
          controller: :jobs,
          action: :new,
          user_id: @user&.id,
          guest_id: @guest&.id,
          program_id: @program.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".program_schedules"),
    {
      controller: :program_schedules,
      action: :index,
      user_id: @user&.id,
      program_id: @program.id
    },
    class: :link
  ) %>
</div>

<% if can?(:create, ProgramSchedule) %>
  <div class="p">
    <%= link_to(
      t(".new_program_schedule"),
      {
        controller: :program_schedules,
        action: :new,
        user_id: @user&.id,
        program_id: @program.id
      },
      class: "button"
    ) %>
  </div>
<% end %>

<%= render_collection(
  partial: "program_schedules/program_schedule",
  collection: @program_schedules,
  as: :program_schedule,
  locals: {
    nested: [@user, @program]
  }
) %>

<div class="p font-bold">
  <%= link_to(
    t(".program_executions"),
    {
      controller: :program_executions,
      action: :index,
      user_id: @user&.id,
      program_id: @program.id
    },
    class: :link
  ) %>
</div>

<% if can?(:create, ProgramExecution) %>
  <div class="p">
    <%= link_to(
      t(".new_program_execution"),
      {
        controller: :program_executions,
        action: :new,
        user_id: @user&.id,
        program_id: @program.id
      },
      class: "button"
    ) %>
  </div>
<% end %>

<%= render_collection(
  partial: "program_executions/program_execution",
  collection: @program_executions,
  as: :program_execution,
  locals: {
    nested: [@user, @program]
  }
) %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        user_id: @user&.id,
