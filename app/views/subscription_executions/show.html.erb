<% content_for(:title, @subscription_execution) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_execution) %>

<% if @subscription_execution.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @subscription_execution.id %></div>
  </div>
<% end %>

<% if @subscription_execution.subscription_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".subscription_id") %></div>
    <% association = @subscription_execution.subscription %>
    <div class="font-bold">
      <%= link_to_if(can?(:show, association), association, association, class: :link) %>
    </div>
  </div>
<% end %>

<% if @subscription_execution.status.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".status") %></div>
    <div class="font-bold">
      <%= @subscription_execution.translated_status %>
    </div>
  </div>
<% end %>

<% if @subscription_execution.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription_execution.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription_execution.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription_execution.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if can?(:update, @subscription_execution) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".step_executions"),
    step_executions_path(subscription_execution_id: @subscription_execution.id),
    class: :link
  ) %>
</div>
<% if can?(:create, StepExecution) %>
  <div class="p">
    <%= link_to(
      t(".new_step_execution"),
      new_step_execution_path(
        step_execution: {
          subscription_execution_id: @subscription_execution.id
        }
      ),
      class: "button"
    ) %>
  </div>
<% end %>
<%= render_collection(
  partial: "step_executions/step_execution",
  collection: @step_executions,
  as: :step_execution
) %>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
