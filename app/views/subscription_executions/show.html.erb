<% content_for(:title, @subscription_execution) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_execution) %>

<%= render("shared/attribute", label: t(".id"), value: @subscription_execution.id) %>

<%= render(
  "shared/attribute",
  label: t(".subscription_id"),
  value: @subscription_execution.subscription,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".status"),
  value: @subscription_execution.translated_status
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @subscription_execution.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @subscription_execution.created_at,
  type: :time
) %>

<% if can?(:update, @subscription_execution) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".step_executions"),
    step_executions_path(subscription_execution_id: @subscription_execution.id),
    class: :link
  ) %>
</div>
<% if can?(:create, StepExecution) %>
  <div class="p">
    <%= link_to(
      t(".new_step_execution"),
      new_step_execution_path(
        step_execution: {
          subscription_execution_id: @subscription_execution.id
        }
      ),
      class: "button"
    ) %>
  </div>
<% end %>
<%= render_collection(
  partial: "step_executions/step_execution",
  collection: @step_executions,
  as: :step_execution
) %>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
