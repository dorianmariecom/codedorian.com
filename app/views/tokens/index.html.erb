<%= turbo_stream_from(@tokens) %>

<% if can?(:create, Token) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @tokens.any? && (can?(:destroy_all, Token) || can?(:delete_all, Token)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Token) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Token) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "tokens/token", collection: @tokens, as: :token) %>
</turbo-frame>
