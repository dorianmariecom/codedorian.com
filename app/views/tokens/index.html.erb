<%= turbo_stream_from(@tokens) %>

<% if can?(:index, Job) %>
  <%
    records = policy_scope(Job)
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "jobs",
    url: { controller: :jobs, action: :index, user_id: @user&.id }.compact
  ) %>
<% end %>
