<%= turbo_stream_from(@tokens) %>

<% if can?(:index, Job) %>
  <%
    records = policy_scope(Job)
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".jobs", count: records.distinct.count),
      { controller: :jobs, action: :index, user_id: @user&.id }.compact,
      class: :link
    ) %>
  </div>
<% end %>
