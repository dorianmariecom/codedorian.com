<% content_for(:title, @country_code_ip_address) %>

<%= turbo_stream_from(@country_code_ip_address) %>

<%= render("shared/attribute", label: t(".id"), value: @country_code_ip_address.id) %>

<%= render(
  "shared/attribute",
  label: t(".ip_address"),
  value: @country_code_ip_address.ip_address
) %>

<%= render(
  "shared/attribute",
  label: t(".country_code"),
  value: @country_code_ip_address.country_code
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @country_code_ip_address.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @country_code_ip_address.created_at,
  type: :time
) %>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".lookup"),
    url: [*show_url, :lookup],
    method: :post,
    class: "button"
  ) %>
</div>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        country_code_ip_address_id: @country_code_ip_address&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        {
          controller: :versions,
          action: :new,
          country_code_ip_address_id: @country_code_ip_address&.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [@country_code_ip_address]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        country_code_ip_address_id: @country_code_ip_address&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
          action: :new,
          country_code_ip_address_id: @country_code_ip_address&.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@country_code_ip_address]
    }
  ) %>
<% end %>
