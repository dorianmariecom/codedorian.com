<%= turbo_stream_from(@country_code_ip_addresses) %>

<% if can?(:index, Version) %>
  <% records = policy_scope(Version) %>
  <div class="p">
    <%= link_to(
      t(".versions", count: records.distinct.count),
      { controller: :versions, action: :index }.compact,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, Log) %>
  <% records = policy_scope(Log) %>
  <div class="p">
    <%= link_to(
      t(".logs", count: records.distinct.count),
      { controller: :logs, action: :index }.compact,
      class: :link
    ) %>
  </div>
<% end %>

<% if can?(:create, CountryCodeIpAddress) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @country_code_ip_addresses.any? &&
    (
      can?(:destroy_all, CountryCodeIpAddress) ||
        can?(:delete_all, CountryCodeIpAddress)
    ) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, CountryCodeIpAddress) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, CountryCodeIpAddress) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "country_code_ip_addresses/country_code_ip_address",
    collection: @country_code_ip_addresses,
    as: :country_code_ip_address
  ) %>
</turbo-frame>
