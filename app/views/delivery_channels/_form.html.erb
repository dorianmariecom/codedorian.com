<%= form_with model: delivery_channel do |f| %>
  <div class="p">
    <%= f.label :key, class: :label %>
    <%= f.select :key,
             delivery_channel_key_options(key: f.object.key),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :amount_cents, class: :label %>
    <%= f.number_field :amount_cents, class: :input %>
  </div>
  <div class="p">
    <%= f.label :amount_currency, class: :label %>
    <%= f.text_field :amount_currency, class: :input %>
  </div>
  <div class="p">
    <%= f.label :delivery_connection_id, class: :label %>
    <%= f.select :delivery_connection_id,
             delivery_connection_options(
               delivery_connection_id: f.object.delivery_connection_id
             ),
             { include_blank: true },
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :enabled, class: :label %>
    <%= f.check_box :enabled, class: :input %>
  </div>
  <div class="p">
    <%= f.label :show_recipient, class: :label %>
    <%= f.check_box :show_recipient, class: :input %>
  </div>
  <div class="p">
    <%= f.label :show_visibility, class: :label %>
    <%= f.check_box :show_visibility, class: :input %>
  </div>
  <div class="p">
    <%= f.label :messaging_service_sid, class: :label %>
    <%= f.text_field :messaging_service_sid, class: :input %>
  </div>
  <div class="p">
    <%= f.label :content_sid_en, class: :label %>
    <%= f.text_field :content_sid_en, class: :input %>
  </div>
  <div class="p">
    <%= f.label :content_sid_fr, class: :label %>
    <%= f.text_field :content_sid_fr, class: :input %>
  </div>
  <div class="p">
    <%= f.label :callback_base_url, class: :label %>
    <%= f.text_field :callback_base_url, class: :input %>
  </div>
  <div class="p">
    <%= f.label :private_delivery_enabled, class: :label %>
    <%= f.check_box :private_delivery_enabled, class: :input %>
  </div>
  <div class="p">
    <%= f.submit submit,
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: submit
             } %>
  </div>
<% end %>
