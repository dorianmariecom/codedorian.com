<% content_for :description, t(".manage") %>
<% content_for :title, t(".manage") %>
<%= form_with model: delivery_channel do |f| %>
  <% delivery_channel.errors.full_messages.each do |message| %>
    <div class="p text-red-600"><%= message %></div>
  <% end %>
  <div class="p">
    <%= f.label :key, t(".channel"), class: :label %>
    <%= f.select :key,
             DeliveryChannel::KEYS.map { |key| [t(".channels.#{key}"), key] },
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :amount_cents, t(".monthly_cents"), class: :label %>
    <%= f.number_field :amount_cents, min: 0, class: :input %>
  </div>
  <div class="p">
    <%= f.label :amount_currency, t(".currency"), class: :label %>
    <%= f.text_field :amount_currency, class: :input %>
  </div>
  <div class="p">
    <%= f.check_box :show_recipient %>
    <%= f.label :show_recipient, t(".show_recipient") %>
  </div>
  <div class="p">
    <%= f.check_box :show_visibility %>
    <%= f.label :show_visibility, t(".show_visibility") %>
  </div>
  <div class="p">
    <%= f.label :delivery_connection_id, t(".connection"), class: :label %>
    <%= f.select :delivery_connection_id,
             policy_scope(DeliveryConnection).where_admin.map { |connection|
               [connection.name, connection.id]
             },
             { include_blank: true },
             class: :input %>
  </div>
  <div class="p">
    <%= hidden_field_tag "delivery_channel[settings][private_delivery_enabled]", "0" %>
    <%= check_box_tag "delivery_channel[settings][private_delivery_enabled]",
                  "1",
                  delivery_channel.settings["private_delivery_enabled"] == true,
                  id: "private_delivery_enabled" %>
    <%= label_tag "private_delivery_enabled", t(".reddit_private_verified") %>
  </div>
  <% %w[messaging_service_sid content_sid_en content_sid_fr callback_base_url].each do |key| %>
    <div class="p">
      <%= label_tag key, key.humanize, class: :label %>
      <%= text_field_tag "delivery_channel[settings][#{key}]",
                     delivery_channel.settings[key],
                     id: key,
                     class: :input %>
    </div>
  <% end %>
  <div class="p">
    <%= f.check_box :enabled %><%= f.label :enabled, t(".enabled") %>
  </div>
  <div class="p">
    <%= f.submit t(".save"),
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: t(".save")
             } %>
  </div>
<% end %>
