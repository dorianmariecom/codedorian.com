<% if can?(:create, DeliveryChannel) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @delivery_channels.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, DeliveryChannel) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, DeliveryChannel) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "delivery_channels/delivery_channel",
    collection: @delivery_channels,
    as: :delivery_channel
  ) %>
</turbo-frame>
