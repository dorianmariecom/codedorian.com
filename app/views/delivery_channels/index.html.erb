<% content_for(:title, t(".title")) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_channels) %>

<% if can?(:index, DeliveryDestination) %>
  <%
    records = policy_scope(DeliveryDestination)
    records = records.where_connection(@connection) if @connection
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "delivery_destinations",
    url: {
      controller: :delivery_destinations,
      action: :index,
      connection_id: @connection&.id,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
