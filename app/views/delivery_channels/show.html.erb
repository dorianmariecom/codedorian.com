<% content_for(:title, @delivery_channel) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_channel) %>
<% if admin? %>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:id) %>
    </div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery_channel.id %></div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:key) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.key %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:amount_cents) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.amount_cents %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:amount_currency) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.amount_currency %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:delivery_connection_id) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.delivery_connection_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:enabled) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.enabled %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:show_recipient) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.show_recipient %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:show_visibility) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.show_visibility %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:messaging_service_sid) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.messaging_service_sid %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:content_sid_en) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.content_sid_en %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:content_sid_fr) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.content_sid_fr %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:callback_base_url) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.callback_base_url %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= DeliveryChannel.human_attribute_name(:public_pattern) %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery_channel.public_pattern %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= DeliveryChannel.human_attribute_name(:private_pattern) %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery_channel.private_pattern %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= DeliveryChannel.human_attribute_name(:show_connection) %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery_channel.show_connection %></div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:only) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.only %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:created_at) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.created_at %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= DeliveryChannel.human_attribute_name(:updated_at) %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_channel.updated_at %>
    </div>
  </div>
<% else %>
  <div class="p"><%= @delivery_channel %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_channel) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_channel) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_channel) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_channel_id: @delivery_channel.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_channel_id: @delivery_channel.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_channel]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_channel_id: @delivery_channel.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_channel_id: @delivery_channel.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_channel]
    }
  ) %>
<% end %>
