<% content_for(:title, @delivery_channel) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_channel) %>
<% if admin? %>
  <%= render("shared/attribute", label: t(".id"), value: @delivery_channel.id) %>
  <%= render("shared/attribute", label: t(".key"), value: @delivery_channel.key) %>
  <%= render(
    "shared/attribute",
    label: t(".amount_cents"),
    value: @delivery_channel.amount_cents
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".amount_currency"),
    value: @delivery_channel.amount_currency
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".delivery_connection_id"),
    value: @delivery_channel.delivery_connection_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".enabled"),
    value: @delivery_channel.enabled
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".show_recipient"),
    value: @delivery_channel.show_recipient
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".show_visibility"),
    value: @delivery_channel.show_visibility
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".messaging_service_sid"),
    value: @delivery_channel.messaging_service_sid
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".content_sid_en"),
    value: @delivery_channel.content_sid_en
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".content_sid_fr"),
    value: @delivery_channel.content_sid_fr
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".callback_base_url"),
    value: @delivery_channel.callback_base_url
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".public_pattern"),
    value: @delivery_channel.public_pattern
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".private_pattern"),
    value: @delivery_channel.private_pattern
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".show_connection"),
    value: @delivery_channel.show_connection
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".visibility_restriction"),
    value: @delivery_channel.visibility_restriction
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @delivery_channel.created_at,
    type: :time
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @delivery_channel.updated_at,
    type: :time
  ) %>
<% else %>
  <div class="p"><%= @delivery_channel %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_channel) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_channel) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_channel) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_channel_id: @delivery_channel.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_channel_id: @delivery_channel.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_channel]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_channel_id: @delivery_channel.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_channel_id: @delivery_channel.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_channel]
    }
  ) %>
<% end %>
