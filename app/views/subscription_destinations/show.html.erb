<% content_for(:title, @subscription_destination) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription_destination) %>
<% if admin? %>
  <%= render("shared/attribute", label: t(".id"), value: @subscription_destination.id) %>
  <%= render(
    "shared/attribute",
    label: t(".subscription_id"),
    value: @subscription_destination.subscription_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".delivery_destination_id"),
    value: @subscription_destination.delivery_destination_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".amount_cents"),
    value: @subscription_destination.amount_cents
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".amount_currency"),
    value: @subscription_destination.amount_currency
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".active"),
    value: @subscription_destination.active
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".selected"),
    value: @subscription_destination.selected
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @subscription_destination.created_at,
    type: :time
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @subscription_destination.updated_at,
    type: :time
  ) %>
<% else %>
  <div class="p"><%= @subscription_destination %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @subscription_destination) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @subscription_destination) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @subscription_destination) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              subscription_destination_id: @subscription_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                subscription_destination_id: @subscription_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @subscription_destination]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              subscription_destination_id: @subscription_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                subscription_destination_id: @subscription_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @subscription_destination]
    }
  ) %>
<% end %>
