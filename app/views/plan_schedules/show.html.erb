<% content_for(:title, @plan_schedule) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@plan_schedule) %>

<%= render("shared/attribute", label: t(".id"), value: @plan_schedule.id) %>

<%= render(
  "shared/attribute",
  label: t(".plan_id"),
  value: @plan_schedule.plan,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".starts_at"),
  value: @plan_schedule.starts_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".interval"),
  value: @plan_schedule.interval
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @plan_schedule.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @plan_schedule.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
