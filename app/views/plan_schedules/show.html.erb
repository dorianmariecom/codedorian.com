<% content_for(:title, @plan_schedule) %>
<% content_for(:description, @plan_schedule.to_s) %>
<%= turbo_stream_from(@plan_schedule) %>

<% if @plan_schedule.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @plan_schedule.id %></div>
  </div>
<% end %>

<% if @plan_schedule.plan_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".plan_id") %></div>
    <% association = @plan_schedule.plan %>
    <div class="font-bold"><%= link_to_if(can?(:show, association), association, association, class: :link) %></div>
  </div>
<% end %>

<% if @plan_schedule.starts_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".starts_at") %></div>
    <div class="font-bold"><%= local_time(@plan_schedule.starts_at, format: :default) %></div>
  </div>
<% end %>

<% if @plan_schedule.interval.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".interval") %></div>
    <div class="font-bold"><%= @plan_schedule.interval %></div>
  </div>
<% end %>

<% if @plan_schedule.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold"><%= local_time(@plan_schedule.updated_at, format: :default) %></div>
  </div>
<% end %>

<% if @plan_schedule.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold"><%= local_time(@plan_schedule.created_at, format: :default) %></div>
  </div>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(partial: "versions/version", collection: @versions, as: :version, locals: { nested: [] }) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(partial: "logs/log", collection: @logs, as: :log, locals: { nested: [] }) %>
<% end %>
