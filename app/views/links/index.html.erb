<%= turbo_stream_from(@links) %>

<% if can?(:index, Version) %>
  <% records = policy_scope(Version) %>
  <%= render(
    "shared/count",
    records: records,
    translation: "versions",
    url: { controller: :versions, action: :index }.compact
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <% records = policy_scope(Log) %>
  <%= render(
    "shared/count",
    records: records,
    translation: "logs",
    url: { controller: :logs, action: :index }.compact
  ) %>
<% end %>

<% if can?(:create, Link) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @links.any? && (can?(:destroy_all, Link) || can?(:delete_all, Link)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Link) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Link) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "links/link", collection: @links, as: :link) %>
</turbo-frame>
