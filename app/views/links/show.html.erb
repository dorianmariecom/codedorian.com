<% content_for(:title, @link) %>

<%= turbo_stream_from(@link) %>

<%= render("shared/attribute", label: t(".kind"), value: @link.kind) %>

<%= render("shared/attribute", label: t(".verb"), value: @link.verb) %>

<%= render("shared/attribute", label: t(".title_en"), value: @link.title_en) %>

<%= render("shared/attribute", label: t(".title_fr"), value: @link.title_fr) %>

<%= render("shared/attribute", label: t(".path_input"), value: @link.path_input) %>

<%= render(
  "shared/attribute",
  label: t(".visibility_input"),
  value: @link.visibility_input
) %>

<%= render("shared/attribute", label: t(".image_ios"), value: @link.image_ios) %>

<%= render(
  "shared/attribute",
  label: t(".image_android"),
  value: @link.image_android
) %>

<%= render("shared/attribute", label: t(".position"), value: @link.position) %>

<%= render("shared/attribute", label: t(".default"), value: @link.default) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      { controller: :versions, action: :index, link_id: @link&.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [@link]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, link_id: @link&.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@link]
    }
  ) %>
<% end %>
