<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@plans) %>

<% if can?(:index, Step) %>
  <%
    records = policy_scope(Step)
    records = records.where_service(@service) if @service
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".steps", count: records.distinct.count),
      {
        controller: :steps,
        action: :index,
        service_id: @service&.id,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>
