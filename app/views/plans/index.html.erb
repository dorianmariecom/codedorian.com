<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@plans) %>

<% if @plan_schedules.any? %>
  <div class="p">
    <%= link_to(
      t(".plan_schedules", count: @plan_schedules.size),
      plan_schedules_path,
      class: :link
    ) %>
  </div>
<% end %>
<% if @subscriptions.any? %>
  <div class="p">
    <%= link_to(
      t(".subscriptions", count: @subscriptions.size),
      subscriptions_path,
      class: :link
    ) %>
  </div>
<% end %>

<div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @plans.any? %>
    <div class="p p--flex">
      <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
    </div>
  <% end %>

  <%= render_collection(partial: "plans/plan", collection: @plans, as: :plan) %>
</turbo-frame>
