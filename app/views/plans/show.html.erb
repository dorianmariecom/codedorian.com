<% content_for(:title, @plan) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@plan) %>

<% if can?(:update, @plan) || advanced? %>
  <% if @plan.id.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".id") %></div>
      <div class="font-bold"><%= @plan.id %></div>
    </div>
  <% end %>

  <% if @plan.service_id.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".service_id") %></div>
      <% association = @plan.service %>
      <div class="font-bold">
        <%= link_to_if(can?(:show, association), association, association, class: :link) %>
      </div>
    </div>
  <% end %>

  <% %i[name_en name_fr description_en description_fr body_en body_fr].each do |attribute| %>
    <% if @plan.public_send(attribute).present? %>
      <div class="p">
        <div class="text-gray-600"><%= t(".#{attribute}") %></div>
        <%= @plan.public_send(attribute) %>
      </div>
    <% end %>
  <% end %>

  <% if @plan.pricing_input.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".pricing_input") %></div>
      <% if can?(:update, @plan) %>
        <%= link_to(edit_url, class: "block") do %>
          <%= code_highlight(@plan.pricing_input) %>
        <% end %>
      <% else %>
        <%= code_highlight(@plan.pricing_input) %>
      <% end %>
    </div>
  <% end %>

  <% if @plan.updated_at.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".updated_at") %></div>
      <div class="font-bold">
        <%= local_time(@plan.updated_at, format: :default) %>
      </div>
    </div>
  <% end %>

  <% if @plan.created_at.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".created_at") %></div>
      <div class="font-bold">
        <%= local_time(@plan.created_at, format: :default) %>
      </div>
    </div>
  <% end %>

  <% if can?(:update, @plan) %>
    <div class="p p--flex">
      <%= link_to(t(".edit"), edit_url, class: :link) %>
      <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
      <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
    </div>
  <% end %>

  <% if can?(:index, PlanField) %>
    <div class="p font-bold">
      <%= link_to(t(".plan_fields"), plan_fields_path(plan_id: @plan.id), class: :link) %>
    </div>
    <% if can?(:create, PlanField) %>
      <div class="p">
        <%= link_to(
          t(".new_plan_field"),
          new_plan_field_path(plan_field: { plan_id: @plan.id }),
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "plan_fields/plan_field",
      collection: @plan_fields,
      as: :plan_field
    ) %>
  <% end %>

  <div class="p font-bold">
    <%= link_to(
      t(".plan_schedules"),
      plan_schedules_path(plan_id: @plan.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, PlanSchedule) %>
    <div class="p">
      <%= link_to(
        t(".new_plan_schedule"),
        new_plan_schedule_path(plan_schedule: { plan_id: @plan.id }),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "plan_schedules/plan_schedule",
    collection: @plan_schedules,
    as: :plan_schedule
  ) %>

  <div class="p font-bold">
    <%= link_to(
      t(".subscriptions"),
      subscriptions_path(plan_id: @plan.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, Subscription) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription"),
        new_subscription_path(plan_id: @plan.id),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscriptions/subscription",
    collection: @subscriptions,
    as: :subscription
  ) %>

  <% if can?(:index, Version) %>
    <div class="p font-bold"><%= t(".versions") %></div>
    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          { controller: :versions, action: :new, plan_id: @plan.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: []
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold"><%= t(".logs") %></div>
    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          { controller: :logs, action: :new, plan_id: @plan.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: []
      }
    ) %>
  <% end %>

  <% if can?(:index, SubscriptionExecution) %>
    <div class="p font-bold">
      <%= link_to(
        t(".subscription_executions"),
        subscription_executions_path(plan_id: @plan.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, SubscriptionExecution) %>
      <div class="p">
        <%= link_to(
          t(".new_subscription_execution"),
          new_subscription_execution_path,
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "subscription_executions/subscription_execution",
      collection: @subscription_executions,
      as: :subscription_execution
    ) %>
  <% end %>

  <% if can?(:index, Step) %>
    <div class="p font-bold">
      <%= link_to(t(".steps"), steps_path(service_id: @plan.service_id), class: :link) %>
    </div>
    <% if can?(:create, Step) %>
      <div class="p">
        <%= link_to(
          t(".new_step"),
          new_step_path(step: { service_id: @plan.service_id }),
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(partial: "steps/step", collection: @steps, as: :step) %>
  <% end %>

  <% if can?(:index, StepExecution) %>
    <div class="p font-bold">
      <%= link_to(
        t(".step_executions"),
        step_executions_path(plan_id: @plan.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, StepExecution) %>
      <div class="p">
        <%= link_to(t(".new_step_execution"), new_step_execution_path, class: "button") %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "step_executions/step_execution",
      collection: @step_executions,
      as: :step_execution
    ) %>
  <% end %>
<% else %>
  <%= render("plans/public_plan", plan: @plan, link_name: false) %>
<% end %>
