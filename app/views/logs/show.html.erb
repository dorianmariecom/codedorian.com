<% content_for(:title, @log) %>

<%= turbo_stream_from(@log) %>

<%= render("shared/attribute", label: t(".id"), value: @log.id) %>

<%= render("shared/attribute", label: t(".message"), value: @log.message) %>

<%= render(
  "shared/attribute",
  label: t(".context"),
  value: @log.context_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @log.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @log.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>
