<%= turbo_stream_from(@logs) %>

<% if can?(:create, Log) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @logs.any? && (can?(:destroy_all, Log) || can?(:delete_all, Log)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Log) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Log) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "logs/log", collection: @logs, as: :log) %>
</turbo-frame>
