<% content_for(:title, @job_recurring_task) %>

<%= turbo_stream_from(@job_recurring_task) %>

<%= render("shared/attribute", label: t(".id"), value: @job_recurring_task.id) %>

<%= render("shared/attribute", label: t(".key"), value: @job_recurring_task.key) %>

<%= render(
  "shared/attribute",
  label: t(".class_name"),
  value: @job_recurring_task.class_name
) %>

<%= render(
  "shared/attribute",
  label: t(".command"),
  value: @job_recurring_task.command,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".schedule"),
  value: @job_recurring_task.schedule
) %>

<%= render(
  "shared/attribute",
  label: t(".queue_name"),
  value: @job_recurring_task.queue_name
) %>

<%= render(
  "shared/attribute",
  label: t(".priority"),
  value: @job_recurring_task.priority
) %>

<%= render(
  "shared/attribute",
  label: t(".static"),
  value: @job_recurring_task.static?
) %>

<%= render(
  "shared/attribute",
  label: t(".arguments"),
  value: @job_recurring_task.arguments_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".description"),
  value: @job_recurring_task.description,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_recurring_task.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_recurring_task.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        job_recurring_task_id: @job_recurring_task&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
          action: :new,
          job_recurring_task_id: @job_recurring_task&.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_recurring_task]
    }
  ) %>
<% end %>
