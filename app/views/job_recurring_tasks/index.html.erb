<%= turbo_stream_from(@job_recurring_tasks) %>
<% if can?(:index, JobContext) %>
  <%= render(
    "shared/count",
    records: policy_scope(JobContext),
    translation: "job_contexts",
    url: {
      controller: :job_contexts,
      action: :index
    }
  ) %>
<% end %>

<% if can?(:index, JobRecurringExecution) %>
  <% records = policy_scope(JobRecurringExecution) %>
  <%= render(
    "shared/count",
    records: records,
    translation: "job_recurring_executions",
    url: { controller: :job_recurring_executions, action: :index }.compact
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <% records = policy_scope(Log) %>
  <%= render(
    "shared/count",
    records: records,
    translation: "logs",
    url: { controller: :logs, action: :index }.compact
  ) %>
<% end %>

<% if can?(:create, JobRecurringTask) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_recurring_tasks.any? &&
    (can?(:destroy_all, JobRecurringTask) || can?(:delete_all, JobRecurringTask)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobRecurringTask) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobRecurringTask) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_recurring_tasks/job_recurring_task",
    collection: @job_recurring_tasks,
    as: :job_recurring_task
  ) %>
</turbo-frame>
