<%= turbo_stream_from(@pages) %>

<% if can?(:index, Page) %>
  <%
    records = policy_scope(Page)
    records = records.where_guest(@guest) if @guest
    records = records.where_page(@parent) if @parent
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".pages", count: records.distinct.count),
      {
        controller: :pages,
        action: :index,
        guest_id: @guest&.id,
        page_id: @parent&.id,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>
