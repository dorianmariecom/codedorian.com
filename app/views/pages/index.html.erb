<%= turbo_stream_from(@pages) %>

<% if can?(:create, Page) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @pages.any? && (can?(:destroy_all, Page) || can?(:delete_all, Page)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Page) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Page) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "pages/page", collection: @pages, as: :page) %>
</turbo-frame>
