<% content_for(:title, @page.title) %>
<% content_for(:description, @page.description) %>

<%= turbo_stream_from(@page) %>

<% if page_displayed? %>
  <p class="p">
    <b><%= @page.title.to_plain_text %></b>
  </p>
  <div class="p"><%= @page.body %></div>
<% else %>
  <%= render("shared/attribute", label: t(".id"), value: @page.id) %>

  <%= render("shared/attribute", label: t(".user"), value: @page.user, type: :record) %>

  <%= render(
    "shared/attribute",
    label: t(".parent"),
    value: @page.parent,
    type: :record,
    url: [*nested, @page.parent]
  ) %>

  <%= render("shared/attribute", label: t(".path"), value: @page.path) %>

  <%= render(
    "shared/attribute",
    label: t(".title_en"),
    value: @page.title_en,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".title_fr"),
    value: @page.title_fr,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".description_en"),
    value: @page.description_en,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".description_fr"),
    value: @page.description_fr,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".body_en"),
    value: @page.body_en,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".body_fr"),
    value: @page.body_fr,
    type: :content
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".authorization_input"),
    value: @page.authorization_input,
    type: :code,
    url: can?(:update, @page) ? edit_url : nil
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @page.updated_at,
    type: :time
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @page.created_at,
    type: :time
  ) %>

  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>

  <% if can?(:index, Version) %>
    <div class="p font-bold">
      <%= link_to(
        t(".versions"),
        {
          controller: :versions,
          action: :index,
          user_id: @user&.id,
          guest_id: @guest&.id,
          page_id: @page.id
        },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          {
            controller: :versions,
            action: :new,
            user_id: @user&.id,
            guest_id: @guest&.id,
            page_id: @page.id
          },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: [*nested, @page]
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold">
      <%= link_to(
        t(".logs"),
        {
          controller: :logs,
          action: :index,
          user_id: @user&.id,
          guest_id: @guest&.id,
          page_id: @page.id
        },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          {
            controller: :logs,
            action: :new,
            user_id: @user&.id,
            guest_id: @guest&.id,
            page_id: @page.id
          },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: [*nested, @page]
      }
    ) %>
  <% end %>
<% end %>
