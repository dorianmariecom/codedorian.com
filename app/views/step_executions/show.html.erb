<% content_for(:title, @step_execution) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@step_execution) %>

<%= render("shared/attribute", label: t(".id"), value: @step_execution.id) %>

<%= render(
  "shared/attribute",
  label: t(".subscription_execution_id"),
  value: @step_execution.subscription_execution,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".step_id"),
  value: @step_execution.step,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".status"),
  value: @step_execution.translated_status
) %>

<%= render(
  "shared/attribute",
  label: t(".input"),
  value: @step_execution.input,
  type: :code,
  url: can?(:update, @step_execution) ? edit_url : nil
) %>

<%= render(
  "shared/attribute",
  label: t(".output"),
  value: @step_execution.output,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".error"),
  value: @step_execution.error,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".error_class"),
  value: @step_execution.error_class
) %>

<%= render(
  "shared/attribute",
  label: t(".error_message"),
  value: @step_execution.error_message,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".error_backtrace"),
  value: @step_execution.error_backtrace,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".result"),
  value: @step_execution.result,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @step_execution.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @step_execution.created_at,
  type: :time
) %>

<% if can?(:update, @step_execution) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        step_execution_id: @step_execution.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, step_execution_id: @step_execution.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Delivery) %>
  <div class="p font-bold">
    <%= link_to(
      t(".deliveries"),
      {
        controller: :deliveries,
        action: :index,
        step_execution_id: @step_execution.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "deliveries/delivery",
    collection:
      policy_scope(Delivery)
        .preload(delivery_destination: :delivery_channel)
        .where_step_execution(@step_execution)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :delivery,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Job) %>
  <div class="p font-bold">
    <%= link_to(
      t(".jobs"),
      { controller: :jobs, action: :index, step_execution_id: @step_execution.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "jobs/job",
    collection:
      policy_scope(Job)
        .where_step_execution(@step_execution)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job,
    locals: {
      nested: []
    }
  ) %>
<% end %>
