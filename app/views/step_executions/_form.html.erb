<%= form_for(show_url) do |f| %>
  <div class="p">
    <%= f.label(:subscription_execution_id, class: :label) %>
      <%= f.select(:subscription_execution_id, policy_scope(SubscriptionExecution).order(:id).map { |record| [record.to_s, record.id] }, {}, required: true, class: :input, autocomplete: :off, data: { form_type: :other }) %>
  </div>

  <div class="p">
    <%= f.label(:step_id, class: :label) %>
      <%= f.select(:step_id, policy_scope(Step).order(:id).map { |record| [record.to_s, record.id] }, {}, required: true, class: :input, autocomplete: :off, data: { form_type: :other }) %>
  </div>

  <div class="p">
    <%= f.label(:status, class: :label) %>
      <%= f.select(:status, StepExecution::STATUSES, {}, required: true, class: :input) %>
  </div>

  <div class="p" data-controller="editor" data-editor-language-value="code">
    <%= f.label(:input, class: :label) %>
    <div class="border border-black rounded overflow-hidden">
      <%= f.hidden_field(
        :input,
        autocomplete: :off,
        data: {
          editor_target: :input,
          form_type: :other
        }
      ) %>
      <div class="min-h-96" data-editor-target="editor"></div>
    </div>
  </div>

  <div class="p">
    <%= f.label(:output, class: :label) %>
      <%= f.text_area(:output, class: :input, rows: 10) %>
  </div>

  <div class="p">
    <%= f.label(:error, class: :label) %>
      <%= f.text_area(:error, class: :input, rows: 10) %>
  </div>

  <div class="p">
    <%= f.label(:error_class, class: :label) %>
      <%= f.text_field(:error_class, class: :input, autocomplete: :off, data: { form_type: :other }) %>
  </div>

  <div class="p">
    <%= f.label(:error_message, class: :label) %>
      <%= f.text_area(:error_message, class: :input, rows: 10) %>
  </div>

  <div class="p">
    <%= f.label(:error_backtrace, class: :label) %>
      <%= f.text_area(:error_backtrace, class: :input, rows: 10) %>
  </div>

  <div class="p">
    <%= f.label(:result, class: :label) %>
      <%= f.text_area(:result, class: :input, rows: 10) %>
  </div>

  <div class="p">
    <%= f.submit(submit, class: "button", data: { controller: "bridge--button", bridge__button_title_value: submit }) %>
  </div>
<% end %>
