<%= turbo_stream_from(@sessions) %>

<% if can?(:create, Session) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @sessions.any? && (can?(:destroy_all, Session) || can?(:delete_all, Session)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Session) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Session) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "sessions/session",
    collection: @sessions,
    as: :session
  ) %>
</turbo-frame>
