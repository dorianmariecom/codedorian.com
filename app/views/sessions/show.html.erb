<% content_for(:title, @session) %>

<%= turbo_stream_from(@session) %>

<%= render("shared/attribute", label: t(".id"), value: @session.id) %>

<%= render("shared/attribute", label: t(".session_id"), value: @session.session_id) %>

<%= render(
  "shared/attribute",
  label: t(".user"),
  value: @session.user,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".guest"),
  value: @session.guest,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".data"),
  value: @session.data_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @session.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @session.created_at,
  type: :time
) %>

<% if can?(:update, @session) || can?(:destroy, @session) %>
  <div class="p">
    <% if can?(:update, @session) %>
      <%= link_to(t(".edit"), edit_url, class: :link) %>
    <% end %>
    <% if can?(:destroy, @session) %>
      <%= render("shared/confirm", url: destroy_url, text: t(".destroy"), class: :link) %>
      <%= render("shared/confirm", url: delete_url, text: t(".delete"), class: :link) %>
    <% end %>
  </div>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, session_id: @session&.id },
      class: :link
    ) %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, session_id: @session&.id },
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @session]
    }
  ) %>
<% end %>
