<% content_for(:title, @job_batch) %>

<%= turbo_stream_from(@job_batch) %>

<%= render("shared/attribute", label: t(".id"), value: @job_batch.id) %>

<%= render(
  "shared/attribute",
  label: t(".active_job_batch_id"),
  value: @job_batch.active_job_batch_id
) %>

<%= render(
  "shared/attribute",
  label: t(".description"),
  value: @job_batch.description
) %>

<%= render(
  "shared/attribute",
  label: t(".total_jobs"),
  value: @job_batch.total_jobs
) %>

<%= render(
  "shared/attribute",
  label: t(".completed_jobs"),
  value: @job_batch.completed_jobs
) %>

<%= render(
  "shared/attribute",
  label: t(".failed_jobs"),
  value: @job_batch.failed_jobs
) %>

<%= render(
  "shared/attribute",
  label: t(".enqueued_at"),
  value: @job_batch.enqueued_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".finished_at"),
  value: @job_batch.finished_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".failed_at"),
  value: @job_batch.failed_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".metadata"),
  value: @job_batch.metadata_json
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_batch.created_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_batch.updated_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, job_batch_id: @job_batch.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_batch_id: @job_batch&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_batch]
    }
  ) %>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".jobs"),
    { controller: :jobs, action: :index, job_batch_id: @job_batch.id },
    class: :link
  ) %>
</div>
<%= render_collection(
  partial: "jobs/job",
  collection: @jobs,
  as: :job,
  locals: {
    nested: []
  }
) %>

<div class="p font-bold">
  <%= link_to(
    t(".batch_executions"),
    job_batch_executions_path(job_batch_id: @job_batch.id),
    class: :link
  ) %>
</div>
<%= render_collection(
  partial: "job_batch_executions/job_batch_execution",
  collection: @batch_executions,
  as: :job_batch_execution,
  locals: {
    nested: []
  }
) %>

<% if can?(:index, JobContext) %>
  <div class="p font-bold">
    <%= link_to(
      t(".job_contexts"),
      { controller: :job_contexts, action: :index, job_batch_id: @job_batch.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "job_contexts/job_context",
    collection:
      policy_scope(JobContext)
        .where_job_batch(@job_batch)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job_context,
    locals: {
      nested: []
    }
  ) %>
<% end %>

