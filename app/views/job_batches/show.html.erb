<% content_for(:title, @job_batch) %>

<%= turbo_stream_from(@job_batch) %>

<% if @job_batch.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @job_batch.id %></div>
  </div>
<% end %>

<% if @job_batch.active_job_batch_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".active_job_batch_id") %></div>
    <div class="font-bold"><%= @job_batch.active_job_batch_id %></div>
  </div>
<% end %>

<% if @job_batch.description.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".description") %></div>
    <div class="font-bold"><%= @job_batch.description %></div>
  </div>
<% end %>

<% if @job_batch.total_jobs.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".total_jobs") %></div>
    <div class="font-bold"><%= @job_batch.total_jobs %></div>
  </div>
<% end %>

<% if @job_batch.completed_jobs.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".completed_jobs") %></div>
    <div class="font-bold"><%= @job_batch.completed_jobs %></div>
  </div>
<% end %>

<% if @job_batch.failed_jobs.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".failed_jobs") %></div>
    <div class="font-bold"><%= @job_batch.failed_jobs %></div>
  </div>
<% end %>

<% if @job_batch.enqueued_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".enqueued_at") %></div>
    <div class="font-bold">
      <%= local_time(@job_batch.enqueued_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @job_batch.finished_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".finished_at") %></div>
    <div class="font-bold">
      <%= local_time(@job_batch.finished_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @job_batch.failed_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".failed_at") %></div>
    <div class="font-bold">
      <%= local_time(@job_batch.failed_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @job_batch.metadata.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".metadata") %></div>
    <div class="font-bold"><%= @job_batch.metadata_json %></div>
  </div>
<% end %>

<% if @job_batch.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@job_batch.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @job_batch.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@job_batch.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, job_batch_id: @job_batch&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_batch_id: @job_batch&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_batch]
    }
  ) %>
<% end %>

<div class="p font-bold"><%= t(".jobs") %></div>
<%= render_collection(
  partial: "jobs/job",
  collection: @jobs,
  as: :job,
  locals: {
    nested: []
  }
) %>

<div class="p font-bold"><%= t(".batch_executions") %></div>
<%= render_collection(
  partial: "job_batch_executions/job_batch_execution",
  collection: @batch_executions,
  as: :job_batch_execution,
  locals: {
    nested: []
  }
) %>
