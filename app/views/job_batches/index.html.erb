<%= turbo_stream_from(@job_batches) %>

<% if can?(:index, Job) %>
  <% records = policy_scope(Job) %>
  <div class="p">
    <%= link_to(
      t(".jobs", count: records.distinct.count),
      { controller: :jobs, action: :index }.compact,
      class: :link
    ) %>
  </div>
<% end %>
