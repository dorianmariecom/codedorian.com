<%= turbo_stream_from(@job_batches) %>

<% if can?(:index, Job) %>
  <% records = policy_scope(Job) %>
  <%= render(
    "shared/count",
    records: records,
    translation: "jobs",
    url: { controller: :jobs, action: :index }.compact
  ) %>
<% end %>
