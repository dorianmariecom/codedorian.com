<% content_for(:title, t("email_verifications.submit")) %>
<% content_for(:description, t("email_verifications.confirmation")) %>
<div class="p"><%= @message %></div>
<% if @confirmation %>
  <%= form_with(url: email_verification_path) do |form| %>
    <%= hidden_field_tag(:kind, params[:kind], autocomplete: :off) %>
    <%= hidden_field_tag(:id, params[:id], autocomplete: :off) %>
    <%= hidden_field_tag(:token, params[:token], autocomplete: :off) %>
    <%= hidden_field_tag(:locale, I18n.locale) %>
    <div class="p">
      <%= form.submit(
        t("email_verifications.submit"),
        class: :button,
        data: {
          controller: "bridge--button",
          bridge__button_title_value: t("email_verifications.submit")
        }
      ) %>
    </div>
  <% end %>
<% end %>
