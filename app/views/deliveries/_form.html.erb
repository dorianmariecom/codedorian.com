<%= form_with model: delivery do |f| %>
  <% delivery.errors.full_messages.each do |message| %>
    <div class="p text-red-600"><%= message %></div>
  <% end %>
  <div class="p">
    <%= f.label :subscription_id, Subscription.model_name.human, class: :label %>
    <%= f.select :subscription_id,
             subscription_options(subscription_id: f.object.subscription_id),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :delivery_destination_id, t(".destinations"), class: :label %>
    <%= f.select :delivery_destination_id,
             delivery_destination_options(
               delivery_destination_id: f.object.delivery_destination_id
             ),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :event_key, class: :label %>
    <%= f.text_field :event_key, required: true, class: :input %>
  </div>
  <div class="p">
    <%= f.label :status, class: :label %>
    <%= f.select :status,
             delivery_status_options(status: f.object.status),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= label_tag "payload_subject", "Subject", class: :label %>
    <%= text_area_tag "delivery[payload][subject]",
                  delivery.payload["subject"].presence,
                  id: "payload_subject",
                  class: :input %>
  </div>
  <div class="p">
    <%= label_tag "payload_body_text", "Body text", class: :label %>
    <%= text_area_tag "delivery[payload][body_text]",
                  delivery.payload["body_text"].presence,
                  id: "payload_body_text",
                  class: :input %>
  </div>
  <div class="p">
    <%= label_tag "payload_body_html", "Body html", class: :label %>
    <%= text_area_tag "delivery[payload][body_html]",
                  delivery.payload["body_html"].presence,
                  id: "payload_body_html",
                  class: :input %>
  </div>
  <div class="p">
    <%= label_tag "payload_url", "Url", class: :label %>
    <%= text_area_tag "delivery[payload][url]",
                  delivery.payload["url"].presence,
                  id: "payload_url",
                  class: :input %>
  </div>
  <div class="p">
    <%= label_tag "payload_locale", "Locale", class: :label %>
    <%= text_area_tag "delivery[payload][locale]",
                  delivery.payload["locale"].presence || I18n.locale,
                  id: "payload_locale",
                  class: :input %>
  </div>
  <div class="p">
    <%= f.submit t(".save"),
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: t(".save")
             } %>
  </div>
<% end %>
