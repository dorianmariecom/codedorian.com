<%= form_with model: delivery do |f| %>
  <div class="p">
    <%= f.label :subscription_id, class: :label %>
    <%= f.select :subscription_id,
             subscription_options(subscription_id: f.object.subscription_id),
             { include_blank: true },
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :delivery_destination_id, class: :label %>
    <%= f.select :delivery_destination_id,
             delivery_destination_options(
               delivery_destination_id: f.object.delivery_destination_id
             ),
             { include_blank: true },
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :step_execution_id, class: :label %>
    <%= f.text_field :step_execution_id, class: :input %>
  </div>
  <div class="p">
    <%= f.label :event_key, class: :label %>
    <%= f.text_field :event_key, class: :input %>
  </div>
  <div class="p">
    <%= f.label :status, class: :label %>
    <%= f.select :status,
             delivery_status_options(status: f.object.status),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :subject, class: :label %>
    <%= f.text_area :subject, class: :input %>
  </div>
  <div class="p">
    <%= f.label :body_text, class: :label %>
    <%= f.text_area :body_text, class: :input %>
  </div>
  <div class="p">
    <%= f.label :body_html, class: :label %>
    <%= f.text_area :body_html, class: :input %>
  </div>
  <div class="p">
    <%= f.label :url, class: :label %>
    <%= f.text_field :url, class: :input %>
  </div>
  <div class="p">
    <%= f.label :locale, class: :label %>
    <%= f.text_field :locale, class: :input %>
  </div>
  <div class="p">
    <%= f.label :provider_id, class: :label %>
    <%= f.text_field :provider_id, class: :input %>
  </div>
  <div class="p">
    <%= f.label :error_code, class: :label %>
    <%= f.text_field :error_code, class: :input %>
  </div>
  <div class="p">
    <%= f.submit submit,
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: submit
             } %>
  </div>
<% end %>
