<% content_for(:title, @delivery) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery) %>
<% if admin? %>
  <%= render("shared/attribute", label: t(".id"), value: @delivery.id) %>
  <%= render(
    "shared/attribute",
    label: t(".subscription_id"),
    value: @delivery.subscription_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".delivery_destination_id"),
    value: @delivery.delivery_destination_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".step_execution_id"),
    value: @delivery.step_execution_id
  ) %>
  <%= render("shared/attribute", label: t(".event_key"), value: @delivery.event_key) %>
  <%= render("shared/attribute", label: t(".status"), value: @delivery.status) %>
  <%= render("shared/attribute", label: t(".subject"), value: @delivery.subject) %>
  <%= render("shared/attribute", label: t(".body_text"), value: @delivery.body_text) %>
  <%= render("shared/attribute", label: t(".body_html"), value: @delivery.body_html) %>
  <%= render("shared/attribute", label: t(".url"), value: @delivery.url) %>
  <%= render("shared/attribute", label: t(".locale"), value: @delivery.locale) %>
  <%= render("shared/attribute", label: t(".channel"), value: @delivery.channel) %>
  <%= render("shared/attribute", label: t(".recipient"), value: @delivery.recipient) %>
  <%= render("shared/attribute", label: t(".visibility"), value: @delivery.visibility) %>
  <%= render(
    "shared/attribute",
    label: t(".connection_id"),
    value: @delivery.connection_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".provider_id"),
    value: @delivery.provider_id
  ) %>
  <%= render("shared/attribute", label: t(".error_code"), value: @delivery.error_code) %>
  <%= render("shared/attribute", label: t(".attempts"), value: @delivery.attempts) %>
  <%= render(
    "shared/attribute",
    label: t(".next_attempt_at"),
    value: @delivery.next_attempt_at
  ) %>
  <%= render("shared/attribute", label: t(".created_at"), value: @delivery.created_at, type: :time) %>
  <%= render("shared/attribute", label: t(".updated_at"), value: @delivery.updated_at, type: :time) %>
<% else %>
  <div class="p font-bold"><%= @delivery.subject %></div>
  <div class="p whitespace-pre-wrap"><%= @delivery.body_text %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:retry, @delivery) && @delivery.failed? %>
  <%= button_to t(".retry"), retry_delivery_path(@delivery), class: :button %>
<% end %>
<% if can?(:reconcile, @delivery) && @delivery.uncertain? %>
  <div class="p p--flex">
    <%= button_to t(".statuses.accepted"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :accepted
              },
              class: :button %>
    <%= button_to t(".statuses.delivered"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :delivered
              },
              class: :button %>
    <%= button_to t(".statuses.failed"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :failed
              },
              class: :button %>
  </div>
<% end %>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            { controller: :versions, action: :index, delivery_id: @delivery.id },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              { controller: :versions, action: :new, delivery_id: @delivery.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            { controller: :logs, action: :index, delivery_id: @delivery.id },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              { controller: :logs, action: :new, delivery_id: @delivery.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery]
    }
  ) %>
<% end %>
