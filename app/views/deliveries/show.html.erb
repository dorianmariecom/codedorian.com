<% content_for(:title, @delivery) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery) %>
<% if admin? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.id %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".subscription_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.subscription_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".delivery_destination_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.delivery_destination_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".step_execution_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.step_execution_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".event_key") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.event_key %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".status") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.status %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".subject") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.subject %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".body_text") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.body_text %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".body_html") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.body_html %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".url") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.url %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".locale") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.locale %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".channel") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.channel %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".recipient") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.recipient %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".visibility") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.visibility %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".connection_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.connection_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".provider_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.provider_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".error_code") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.error_code %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".attempts") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.attempts %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".next_attempt_at") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery.next_attempt_at %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.created_at %></div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold whitespace-pre-wrap"><%= @delivery.updated_at %></div>
  </div>
<% else %>
  <div class="p font-bold"><%= @delivery.subject %></div>
  <div class="p whitespace-pre-wrap"><%= @delivery.body_text %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:retry, @delivery) && @delivery.failed? %>
  <%= button_to t(".retry"), retry_delivery_path(@delivery), class: :button %>
<% end %>
<% if can?(:reconcile, @delivery) && @delivery.uncertain? %>
  <div class="p p--flex">
    <%= button_to t(".statuses.accepted"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :accepted
              },
              class: :button %>
    <%= button_to t(".statuses.delivered"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :delivered
              },
              class: :button %>
    <%= button_to t(".statuses.failed"),
              reconcile_delivery_path(@delivery),
              params: {
                outcome: :failed
              },
              class: :button %>
  </div>
<% end %>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            { controller: :versions, action: :index, delivery_id: @delivery.id },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              { controller: :versions, action: :new, delivery_id: @delivery.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            { controller: :logs, action: :index, delivery_id: @delivery.id },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              { controller: :logs, action: :new, delivery_id: @delivery.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery]
    }
  ) %>
<% end %>
