<% content_for :description, t(".manage") %>
<% content_for :title, t(".history") %>
<% @deliveries.each do |delivery| %>
  <div class="p">
    <%= link_to delivery, delivery, class: :link %><%= l(delivery.created_at) %>
  </div>
<% end %>
<%= paginate @deliveries %>

<% if admin? %>
  <div class="p">
    <%= link_to t(".add"), new_delivery_path, class: :button %>
  </div>
<% end %>
