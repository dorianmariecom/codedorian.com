<% content_for(:title, @handle) %>

<%= turbo_stream_from(@handle) %>

<%= render("shared/attribute", label: t(".id"), value: @handle.id) %>

<%= render(
  "shared/attribute",
  label: t(".user"),
  value: @handle.user,
  type: :record
) %>

<%= render("shared/attribute", label: t(".handle"), value: @handle.handle) %>

<%= render("shared/attribute", label: t(".primary"), value: @handle.primary?) %>

<% if admin? %>
  <%= render("shared/attribute", label: t(".verified"), value: @handle.verified?) %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @handle.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @handle.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_handle(@handle)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      { controller: :versions, action: :index, handle_id: @handle&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        { controller: :versions, action: :new, handle_id: @handle&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @handle]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, handle_id: @handle&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, handle_id: @handle&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @handle]
    }
  ) %>
<% end %>
