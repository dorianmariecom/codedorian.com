<%= turbo_stream_from(@handles) %>

<% if can?(:create, Handle) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @handles.any? && (can?(:destroy_all, Handle) || can?(:delete_all, Handle)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Handle) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Handle) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "handles/handle", collection: @handles, as: :handle) %>
</turbo-frame>
