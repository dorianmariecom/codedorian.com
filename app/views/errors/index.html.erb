<%= turbo_stream_from(@errors) %>

<% if @error_occurrences.any? %>
  <div class="p p--flex">
    <%= link_to(
      t(".error_occurrences", count: @error_occurrences.size),
      :error_occurrences,
      class: :link
    ) %>
  </div>
<% end %>

<% if can?(:create, ::Error) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @errors.any? && (can?(:destroy_all, ::Error) || can?(:delete_all, ::Error)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, ::Error) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, ::Error) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "errors/error", collection: @errors, as: :error) %>
</turbo-frame>
