<% content_for(:title, @error) %>

<%= turbo_stream_from(@error) %>

<%= render("shared/attribute", label: t(".id"), value: @error.id) %>

<%= render(
  "shared/attribute",
  label: t(".exception_class"),
  value: @error.exception_class
) %>

<%= render("shared/attribute", label: t(".fingerprint"), value: @error.fingerprint) %>

<%= render("shared/attribute", label: t(".message"), value: @error.message) %>

<%= render("shared/attribute", label: t(".severity"), value: @error.severity) %>

<%= render("shared/attribute", label: t(".source"), value: @error.source) %>

<%= render(
  "shared/attribute",
  label: t(".resolved_at"),
  value: @error.resolved_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @error.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @error.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<div class="p font-bold">
  <%= link_to(
    t(".error_occurrences"),
    [@user, @error, :error_occurrences],
    class: :link
  ) %>
</div>

<% if can?(:create, ErrorOccurrence) %>
  <div class="p">
    <%= link_to(
      t(".new_error_occurrence"),
      [:new, @user, @error, :error_occurrence],
      class: "button"
    ) %>
  </div>
<% end %>

<%= render_collection(
  partial: "error_occurrences/error_occurrence",
  collection: @error_occurrences,
  as: :error_occurrence,
  locals: {
    nested: [@user, @error]
  }
) %>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_error(@error)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        user_id: @user&.id,
        error_id: @error&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, user_id: @user&.id, error_id: @error&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@user, @error]
    }
  ) %>
<% end %>
