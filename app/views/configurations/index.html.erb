<%= turbo_stream_from(@configurations) %>

<% if can?(:create, Configuration) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @configurations.any? &&
    (can?(:destroy_all, Configuration) || can?(:delete_all, Configuration)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Configuration) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Configuration) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "configurations/configuration",
    collection: @configurations,
    as: :configuration
  ) %>
</turbo-frame>
