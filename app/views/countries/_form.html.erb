<%= form_for(show_url) do |f| %>
  <% if admin? %>
    <div class="p">
      <%= f.label(:user_id, class: :label) %>
      <%= f.select(
        :user_id,
        user_options(user_id: f.object.user_id),
        {},
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <% %i[
    ip_address name alpha2 alpha3 numeric_code hostname city region region_code
    continent continent_code postal_code time_zone organization
  ].each do |attribute| %>
    <div class="p">
      <%= f.label(attribute, class: :label) %>
      <%= f.text_field(
        attribute,
        required: attribute == :ip_address,
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <% %i[latitude longitude].each do |attribute| %>
    <div class="p">
      <%= f.label(attribute, class: :label) %>
      <%= f.number_field(
        attribute,
        step: :any,
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <% %i[anycast bogon anonymous hosting mobile satellite primary].each do |attribute| %>
    <div class="p">
      <%= f.label(attribute, class: :label) %>
      <%= f.check_box(
        attribute,
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <% Country::JSON_FIELDS.each do |attribute| %>
    <div class="p">
      <%= f.label(attribute, class: :label) %>
      <%= f.text_area(
        attribute,
        value: JSON.pretty_generate(f.object.public_send(attribute)),
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <% if admin? %>
    <div class="p">
      <%= f.label(:verified, class: :label) %>
      <%= f.check_box(
        :verified,
        class: :input,
        autocomplete: :off,
        data: { form_type: :other }
      ) %>
    </div>
  <% end %>

  <div class="p">
    <%= f.submit(
      submit,
      class: "button",
      data: {
        controller: "bridge--button",
        bridge__button_title_value: submit
      }
    ) %>
  </div>
<% end %>
