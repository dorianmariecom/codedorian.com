<% content_for(:title, @country) %>

<%= turbo_stream_from(@country) %>

<% fields = %i[
  id user ip_address name alpha2 alpha3 numeric_code hostname city region
  region_code continent continent_code latitude longitude postal_code time_zone
  organization anycast bogon anonymous hosting mobile satellite primary verified
] %>
<% fields.each do |attribute| %>
  <% value = @country.public_send(attribute) %>
  <% next if value.nil? %>
  <% next if attribute == :verified && !admin? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".#{attribute}") %></div>
    <div class="font-bold">
      <% if attribute == :user %>
        <%= render("shared/user", user: value) %>
      <% else %>
        <%= value %>
      <% end %>
    </div>
  </div>
<% end %>

<% Country::JSON_FIELDS.each do |attribute| %>
  <div class="p">
    <div class="text-gray-600"><%= t(".#{attribute}") %></div>
    <pre class="overflow-auto"><%= JSON.pretty_generate(@country.public_send(attribute)) %></pre>
  </div>
<% end %>

<% %i[updated_at created_at].each do |attribute| %>
  <div class="p">
    <div class="text-gray-600"><%= t(".#{attribute}") %></div>
    <div class="font-bold">
      <%= local_time(@country.public_send(attribute), format: :default) %>
    </div>
  </div>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      { controller: :versions, action: :index, country_id: @country.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: { nested: [*nested, @country] }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, country_id: @country.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: { nested: [*nested, @country] }
  ) %>
<% end %>
