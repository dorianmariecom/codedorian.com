<%= turbo_stream_from(@countries) %>

<% if can?(:create, Country) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @countries.any? && (can?(:destroy_all, Country) || can?(:delete_all, Country)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Country) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Country) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "countries/country",
    collection: @countries,
    as: :country
  ) %>
</turbo-frame>
