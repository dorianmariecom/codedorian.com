<%= turbo_stream_from(@program_executions) %>

<% if can?(:create, ProgramExecution) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @program_executions.any? &&
    (can?(:destroy_all, ProgramExecution) || can?(:delete_all, ProgramExecution)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, ProgramExecution) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, ProgramExecution) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "program_executions/program_execution",
    collection: @program_executions,
    as: :program_execution
  ) %>
</turbo-frame>
