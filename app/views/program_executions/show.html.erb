<% content_for(:title, @program_execution) %>

<%= turbo_stream_from(@program_execution) %>

<%= render("shared/attribute", label: t(".id"), value: @program_execution.id) %>

<%= render(
  "shared/attribute",
  label: t(".program"),
  value: @program_execution.program,
  type: :record,
  url: [@user, @program_execution.program]
) %>

<%= render(
  "shared/attribute",
  label: t(".status"),
  value: @program_execution.translated_status
) %>

<%= render(
  "shared/attribute",
  label: t(".output"),
  value: @program_execution.output,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".result"),
  value: @program_execution.result,
  type: :code
) %>

<%= render("shared/attribute", label: t(".error"), value: @program_execution.error) %>

<%= render(
  "shared/attribute",
  label: t(".error_class"),
  value: @program_execution.error_class
) %>

<% if admin? %>
  <%= render(
    "shared/attribute",
    label: t(".error_message"),
    value: @program_execution.error_message,
    type: :code
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".error_app_backtrace"),
    value: @program_execution.error_app_backtrace,
    type: :code
  ) %>

  <%= render(
    "shared/attribute",
    label: t(".error_backtrace"),
    value: @program_execution.error_backtrace,
    type: :code
  ) %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".input"),
  value: @program_execution.input,
  type: :code,
  url: can?(:update, @program_execution) ? edit_url : nil
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @program_execution.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @program_execution.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_program_execution(@program_execution)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        user_id: @user&.id,
        program_id: @program&.id,
        program_execution_id: @program_execution.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        {
          controller: :versions,
          action: :new,
          user_id: @user&.id,
          program_id: @program&.id,
          program_execution_id: @program_execution.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [@user, @program, @program_execution]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        user_id: @user&.id,
        program_id: @program&.id,
        program_execution_id: @program_execution.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
          action: :new,
          user_id: @user&.id,
          program_id: @program&.id,
          program_execution_id: @program_execution.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@user, @program, @program_execution]
    }
  ) %>
<% end %>
