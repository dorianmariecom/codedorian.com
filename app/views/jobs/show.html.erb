<% content_for(:title, @job) %>

<%= turbo_stream_from(@job) %>

<% if @job.batch.present? && can?(:show, @job.batch) %>
  <%= render("shared/attribute", label: t(".batch"), value: @job.batch, type: :record) %>
<% end %>

<%= render("shared/attribute", label: t(".id"), value: @job.id) %>

<%= render("shared/attribute", label: t(".class_name"), value: @job.class_name) %>

<%= render("shared/attribute", label: t(".priority"), value: @job.priority) %>

<%= render("shared/attribute", label: t(".queue_name"), value: @job.queue_name) %>

<%= render(
  "shared/attribute",
  label: t(".arguments"),
  value: @job.arguments_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".concurrency_key"),
  value: @job.concurrency_key
) %>

<%= render(
  "shared/attribute",
  label: t(".scheduled_at"),
  value: @job.scheduled_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".finished_at"),
  value: @job.finished_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job.created_at,
  type: :time
) %>

<div class="p">
  <%= render(
    "shared/confirm",
    text: t(".retry"),
    url: [*show_url, :retry],
    method: :post
  ) %>
  <%= render(
    "shared/confirm",
    text: t(".discard"),
    url: [*show_url, :discard],
    method: :post
  ) %>
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<div class="p font-bold">
  <%= link_to(
    t(".job_contexts"),
    { controller: :job_contexts, action: :index, job_id: @job.id },
    class: :link
  ) %>
</div>

<% if can?(:create, JobContext) %>
  <div class="p">
    <%= link_to(
      t(".new_job_context"),
      {
        controller: :job_contexts,
        action: :new,
        job_id: @job.id,
        user_id: @user&.id
      },
      class: "button"
    ) %>
  </div>
<% end %>

<%= render_collection(
  partial: "job_contexts/job_context",
  collection: @job_contexts,
  as: :job_context,
  locals: {
    nested: nested
  }
) %>

