    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_id: @job&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: nested
    }
  ) %>
<% end %>

<% if can?(:index, ::Error) %>
  <div class="p font-bold">
    <%= link_to(
      t(".errors"),
      { controller: :errors, action: :index, job_id: @job.id },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "errors/error",
    collection:
      policy_scope(::Error)
        .where_job(@job)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :error,
    locals: {
      nested: []
    }
  ) %>
<% end %>

