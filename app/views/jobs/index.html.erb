<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @jobs.any? %>
    <div class="p p--flex">
      <%= render(
        "shared/confirm",
        url: [:retry_all, *index_url],
        text: t(".retry_all"),
        method: :post
      ) %>
      <%= render(
        "shared/confirm",
        url: [:discard_all, *index_url],
        text: t(".discard_all"),
        method: :post
      ) %>
      <% if can?(:destroy_all, Job) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Job) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "jobs/job", collection: @jobs, as: :job) %>
</turbo-frame>

<% if can?(:index, JobBatch) %>
  <%= render(
    "shared/count",
    records: @job_batches,
    translation: "job_batches",
    url: job_batches_path
  ) %>
<% end %>
