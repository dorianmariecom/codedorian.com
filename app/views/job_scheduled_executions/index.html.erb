<%= turbo_stream_from(@job_scheduled_executions) %>

<% if can?(:create, JobScheduledExecution) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_scheduled_executions.any? &&
    (
      can?(:destroy_all, JobScheduledExecution) ||
        can?(:delete_all, JobScheduledExecution)
    ) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobScheduledExecution) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobScheduledExecution) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_scheduled_executions/job_scheduled_execution",
    collection: @job_scheduled_executions,
    as: :job_scheduled_execution
  ) %>
</turbo-frame>
