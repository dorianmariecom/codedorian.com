<%= turbo_stream_from(@phone_numbers) %>

<% if can?(:create, PhoneNumber) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @phone_numbers.any? &&
    (can?(:destroy_all, PhoneNumber) || can?(:delete_all, PhoneNumber)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, PhoneNumber) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, PhoneNumber) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "phone_numbers/phone_number",
    collection: @phone_numbers,
    as: :phone_number
  ) %>
</turbo-frame>
