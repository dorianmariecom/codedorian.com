<div class="phone-number border-l border-black pl-5" data-new-record="<%= f.object.new_record? %>">
  <%= f.hidden_field(:id, autocomplete: :off) %><%= f.hidden_field(:_destroy, autocomplete: :off) %>
  <div class="p max-w-xs" data-controller="phone-number"><%= f.label(:phone_number, class: :label, data: { phone_number_target: :label }) %><%= f.telephone_field(:phone_number, class: :input, autocomplete: "tel", data: { phone_number_target: :input, action: "phone-number#input", form_type: :other }) %><div class="text-red-600" hidden data-phone-number-target="error"></div></div>
  <div class="p"><%= f.label(:primary, class: :label) %><%= f.check_box(:primary, autocomplete: :off) %></div>
  <% if admin? %><div class="p"><%= f.label(:verified, class: :label) %><%= f.check_box(:verified, autocomplete: :off) %></div><% end %>
  <div class="p"><button class="link" data-action="nested#remove"><%= t("plan_schedules.nested_form.remove") %></button></div>
</div>
