<div
  class="phone-number border-l border-black pl-5"
  data-new-record="<%= f.object.new_record? %>"
>
  <%= f.hidden_field(:id, autocomplete: :off) %>
  <%= f.hidden_field(:_destroy, autocomplete: :off) %>
  <div class="p max-w-xs" data-controller="phone-number">
    <%= f.hidden_field(
      :phone_number,
      autocomplete: :off,
      data: {
        phone_number_target: :hidden,
        form_type: :other
      }
    ) %>
    <%= f.label(
      :phone_number_input,
      class: :label,
      data: {
        phone_number_target: :label
      }
    ) %>
    <%= f.phone_field(
      :phone_number_input,
      value: f.object.formatted,
      class: :input,
      data: {
        phone_number_target: :input,
        action: "phone-number#input",
        form_type: :other
      },
      autocomplete: "tel"
    ) %>
    <div class="text-red-600" hidden data-phone-number-target="error"></div>
  </div>
  <div class="p">
    <%= f.label(:primary, class: :label) %>
    <%= f.check_box(:primary, autocomplete: :off) %>
  </div>
  <% if admin? %>
    <div class="p">
      <%= f.label(:verified, class: :label) %>
      <%= f.check_box(:verified, autocomplete: :off) %>
    </div>
  <% end %>
  <div class="p">
    <button class="link" data-action="nested#remove">
      <%= t("phone_numbers.nested_form.remove") %>
    </button>
  </div>
</div>
