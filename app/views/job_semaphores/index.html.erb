<%= turbo_stream_from(@job_semaphores) %>

<% if can?(:create, JobSemaphore) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_semaphores.any? && (can?(:destroy_all, JobSemaphore) || can?(:delete_all, JobSemaphore)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobSemaphore) %>
      <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobSemaphore) %>
      <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_semaphores/job_semaphore",
    collection: @job_semaphores,
    as: :job_semaphore
  ) %>
</turbo-frame>
