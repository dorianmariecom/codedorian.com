<% content_for(:title, @job_semaphore) %>

<%= turbo_stream_from(@job_semaphore) %>

<%= render("shared/attribute", label: t(".id"), value: @job_semaphore.id) %>

<%= render(
  "shared/attribute",
  label: t(".key"),
  value: @job_semaphore.key_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".value"),
  value: @job_semaphore.value_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".expires_at"),
  value: @job_semaphore.expires_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_semaphore.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_semaphore.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, job_semaphore_id: @job_semaphore&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_semaphore_id: @job_semaphore&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_semaphore]
    }
  ) %>
<% end %>
