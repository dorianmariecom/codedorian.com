<%= turbo_stream_from(@plan_fields) %>

<% if can?(:index, Version) %>
  <%
    records = policy_scope(Version)
    records = records.where_plan(@plan) if @plan
    records = records.where_service(@service) if @service
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".versions", count: records.distinct.count),
      {
        controller: :versions,
        action: :index,
        plan_id: @plan&.id,
        service_id: @service&.id,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, Log) %>
  <%
    records = policy_scope(Log)
    records = records.where_plan(@plan) if @plan
    records = records.where_service(@service) if @service
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".logs", count: records.distinct.count),
      {
        controller: :logs,
        action: :index,
        plan_id: @plan&.id,
        service_id: @service&.id,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>

<% if can?(:create, PlanField) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<%= render("shared/search") %>
<turbo-frame id="search" target="_top">
  <% if @plan_fields.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, PlanField) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, PlanField) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "plan_fields/plan_field",
    collection: @plan_fields,
    as: :plan_field
  ) %>
</turbo-frame>
