<% content_for(:title, t(".title")) %>
<% content_for(:description, t(".description")) %>
<div class="p"><%= @message %></div>
<% if @confirmation %>
  <%= form_with(url: confirm_verification_delivery_destination_path(id: params[:id])) do |form| %>
    <%= hidden_field_tag(:token, params[:token], autocomplete: :off) %>
    <div class="p">
      <%= form.submit(
        t(".submit"),
        class: :button,
        data: {
          controller: "bridge--button",
          bridge__button_title_value: t(".submit")
        }
      ) %>
    </div>
  <% end %>
<% end %>
