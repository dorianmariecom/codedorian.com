<%= form_with(model: delivery_destination) do |f| %>
  <% if admin? %>
    <div class="p">
      <%= f.label :user_id, class: :label %>
      <%= f.select :user_id, user_options(user_id: f.object.user_id), {}, class: :input %>
    </div>
  <% end %>
  <% channels =
    policy_scope(DeliveryChannel).select do |channel|
      channel.available? || channel.id == delivery_destination.delivery_channel_id
    end %>
  <% channel = channels.find { |record| record.id == f.object.delivery_channel_id } || channels.first %>
  <div
    data-controller="delivery-destination-form"
    data-action="turbo:morph@document->delivery-destination-form#change"
  >
    <div class="p">
      <%= f.label :delivery_channel_id, class: :label %>
      <%= f.select :delivery_channel_id,
               channels.map { |channel|
                 [
                   channel.to_s,
                   channel.id,
                   { data: delivery_channel_form_data(channel) }
                 ]
               },
               {},
               class: :input,
               required: true,
               data: {
                 action: "change->delivery-destination-form#change",
                 "delivery-destination-form-target": "channel"
               } %>
    </div>
    <div
      class="p"
      data-delivery-destination-form-target="recipientRow"
      <%= "hidden" unless channel&.show_recipient? %>
    >
      <%= f.label :recipient, class: :label %>
      <%= f.text_field :recipient,
                   class: :input,
                   data: {
                     "delivery-destination-form-target": "recipient"
                   } %>
    </div>
    <div
      class="p"
      data-delivery-destination-form-target="connectionRow"
      <%= "hidden" unless channel&.show_connection? %>
    >
      <%= f.label :delivery_connection_id, class: :label %>
      <%= f.select :delivery_connection_id,
               delivery_connection_options(
                 delivery_connection_id: f.object.delivery_connection_id
               ),
               { include_blank: true },
               class: :input,
               data: {
                 "delivery-destination-form-target": "connection"
               } %>
    </div>
    <div
      class="p"
      data-delivery-destination-form-target="visibilityRow"
      <%= "hidden" unless channel&.show_visibility? %>
    >
      <%= f.label :visibility, class: :label %>
      <%= f.select :visibility,
               %w[private public].map { |visibility|
                 [t(".#{visibility}"), visibility]
               },
               {},
               class: :input,
               data: {
                 action: "change->delivery-destination-form#change",
                 "delivery-destination-form-target": "visibility"
               } %>
    </div>
    <div class="p">
      <%= f.check_box :enabled %><%= f.label :enabled, t(".enabled") %>
    </div>
    <div class="p">
      <%= f.submit submit,
               class: :button,
               data: {
                 controller: "bridge--button",
                 bridge__button_title_value: submit
               } %>
    </div>
  </div>
<% end %>
