<% content_for(:title, @delivery_destination) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_destination) %>
<% if admin? %>
  <%= render("shared/attribute", label: t(".id"), value: @delivery_destination.id) %>
  <%= render(
    "shared/attribute",
    label: t(".user_id"),
    value: @delivery_destination.user_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".delivery_channel_id"),
    value: @delivery_destination.delivery_channel_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".delivery_connection_id"),
    value: @delivery_destination.delivery_connection_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".recipient"),
    value: @delivery_destination.recipient
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".visibility"),
    value: @delivery_destination.visibility
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".enabled"),
    value: @delivery_destination.enabled
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @delivery_destination.created_at,
    type: :time
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @delivery_destination.updated_at,
    type: :time
  ) %>
<% else %>
  <div class="p"><%= @delivery_destination %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_destination) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_destination) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_destination) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_destination_id: @delivery_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_destination_id: @delivery_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_destination]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_destination_id: @delivery_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_destination_id: @delivery_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_destination]
    }
  ) %>
<% end %>
