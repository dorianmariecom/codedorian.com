<% content_for(:title, @delivery_destination) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_destination) %>
<% if admin? %>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".id") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".user_id") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.user_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".delivery_channel_id") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.delivery_channel_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".delivery_connection_id") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.delivery_connection_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".recipient") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.recipient %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".visibility") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.visibility %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".enabled") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.enabled %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".created_at") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.created_at %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600">
      <%= t(".updated_at") %>
    </div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_destination.updated_at %>
    </div>
  </div>
<% else %>
  <div class="p"><%= @delivery_destination %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_destination) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_destination) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_destination) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_destination_id: @delivery_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_destination_id: @delivery_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_destination]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_destination_id: @delivery_destination.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_destination_id: @delivery_destination.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_destination]
    }
  ) %>
<% end %>
