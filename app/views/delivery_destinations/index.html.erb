<% content_for :description, t(".manage") %>
<% content_for :title, t(".manage") %>
<% if can?(:create, model_class) %>
  <div class="p"><%= link_to t(".add"), new_url, class: :button %></div>
<% end %>
<% @delivery_destinations.each do |record| %>
  <div class="p">
    <%= link_to record, record, class: :link %>
    <% if !record.enabled? %>
      — <%= t(".disabled") %>
    <% end %>
  </div>
<% end %>
<%= paginate @delivery_destinations %>
