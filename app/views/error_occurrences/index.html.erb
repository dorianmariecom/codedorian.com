<% if can?(:create, ErrorOccurrence) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @error_occurrences.any? &&
    (can?(:destroy_all, ErrorOccurrence) || can?(:delete_all, ErrorOccurrence)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, ErrorOccurrence) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, ErrorOccurrence) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "error_occurrences/error_occurrence",
    collection: @error_occurrences,
    as: :error_occurrence
  ) %>
</turbo-frame>
