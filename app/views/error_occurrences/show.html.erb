<% content_for(:title, @error_occurrence) %>

<%= turbo_stream_from(@error_occurrence) %>

<%= render("shared/attribute", label: t(".id"), value: @error_occurrence.id) %>

<%= render(
  "shared/attribute",
  label: t(".error"),
  value: @error_occurrence.error,
  type: :record,
  url: [@user, @error_occurrence.error]
) %>

<%= render(
  "shared/attribute",
  label: t(".context"),
  value: @error_occurrence.context_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".app_backtrace"),
  value: @error_occurrence.app_backtrace,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".full_backtrace"),
  value: @error_occurrence.backtrace,
  type: :code
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @error_occurrence.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @error_occurrence.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_error_occurrence(@error_occurrence)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        error_occurrence_id: @error_occurrence&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
          action: :new,
          error_occurrence_id: @error_occurrence&.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @error_occurrence]
    }
  ) %>
<% end %>
