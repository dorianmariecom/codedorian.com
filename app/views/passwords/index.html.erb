<%= turbo_stream_from(@passwords) %>

<% if can?(:create, Password) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @passwords.any? && (can?(:destroy_all, Password) || can?(:delete_all, Password)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Password) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Password) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "passwords/password",
    collection: @passwords,
    as: :password
  ) %>
</turbo-frame>
