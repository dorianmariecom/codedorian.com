<% content_for(:title, @job_batch_execution) %>

<%= turbo_stream_from(@job_batch_execution) %>

<%= render("shared/attribute", label: t(".id"), value: @job_batch_execution.id) %>

<%= render(
  "shared/attribute",
  label: t(".job_id"),
  value: @job_batch_execution.job,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".batch_id"),
  value: @job_batch_execution.batch,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_batch_execution.created_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_batch_execution.updated_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      {
        controller: :logs,
        action: :index,
        job_batch_execution_id: @job_batch_execution&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        {
          controller: :logs,
          action: :new,
          job_batch_execution_id: @job_batch_execution&.id
        },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @job_batch_execution]
    }
  ) %>
<% end %>
