<% content_for(:title, @user) %>

<%= turbo_stream_from(@user) %>

<% if can?(:index, DeliveryConnection) %>
  <div class="p">
    <%= link_to t(".delivery_connections"), delivery_connections_path, class: :link %>
  </div>
<% end %>

<%= render("shared/attribute", label: t(".id"), value: @user.id) %>

<% if admin? %>
  <%= render("shared/attribute", label: t(".admin"), value: @user.admin) %>
<% end %>

<% if (admin? || advanced?) %>
  <%= render(
    "shared/attribute",
    label: t(".stripe_customer_id"),
    value: @user.stripe_customer_id
  ) %>
<% end %>

<%= render("shared/attribute", label: t(".locale"), value: @user.translated_locale) %>

<%= render(
  "shared/attribute",
  label: t(".interface"),
  value: @user.translated_interface
) %>

<%= render("shared/attribute", label: t(".name"), value: @user.name) %>

<%= render("shared/attribute", label: t(".description"), value: @user.description) %>

<%= render("shared/attribute", label: t(".handle"), value: @user.handle) %>

<%= render(
  "shared/attribute",
  label: t(".email_address"),
  value: @user.email_address
) %>

<%= render("shared/attribute", label: t(".phone_number"), value: @user.phone_number) %>

<%= render("shared/attribute", label: t(".address"), value: @user.address) %>

<%= render("shared/attribute", label: t(".password"), value: @user.password) %>

<%= render("shared/attribute", label: t(".time_zone"), value: @user.time_zone) %>

<%= render("shared/attribute", label: t(".device"), value: @user.device) %>

<% if admin? %>
  <%= render("shared/attribute", label: t(".verified"), value: @user.verified) %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @user.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @user.created_at,
  type: :time
) %>

<div class="p p--flex">
  <% if admin? %>
    <%= render(
      "shared/confirm",
      text: t(".impersonate"),
      url: [*show_url, :impersonate],
      method: :post
    ) %>
  <% end %>
  <%= render("shared/confirm", text: t(".log_out"), url: :login) %>
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
</div>

<%= render("shared/list", user: @user, model: Device, create: advanced?) %>

<% unless simple? %>
  <%= render("shared/list", user: @user, model: Name) %>
  <%= render("shared/list", user: @user, model: Handle) %>
  <%= render("shared/list", user: @user, model: EmailAddress) %>
  <%= render("shared/list", user: @user, model: PhoneNumber) %>
  <%= render("shared/list", user: @user, model: Address) %>
  <%= render("shared/list", user: @user, model: Country) %>
  <%= render("shared/list", user: @user, model: Password) %>
  <%= render("shared/list", user: @user, model: TimeZone) %>
  <%= render("shared/list", user: @user, model: Token) %>
  <%= render("shared/list", user: @user, model: Datum) %>
  <%= render("shared/list", user: @user, model: Message) %>
  <%= render("shared/list", user: @user, model: Program) %>
  <%= render("shared/list", user: @user, model: ProgramExecution) %>
  <%= render("shared/list", user: @user, model: ProgramSchedule) %>
  <% if admin? %>
    <%= render("shared/list", user: @user, model: ::Error) %>
    <%= render("shared/list", user: @user, model: ErrorOccurrence) %>
    <% if can?(:index, Job) %>
      <% jobs =
        policy_scope(Job)
          .where_user(@user)
          .order(created_at: :desc)
          .page(params[:page]) %>

      <div class="p font-bold">
        <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
      </div>

      <% if can?(:create, Job) %>
        <div class="p">
          <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
        </div>
      <% end %>

      <%= render_collection(
        partial: "jobs/job",
        collection: jobs,
        as: :job,
        locals: {
          nested: jobs_nested
        }
      ) %>
    <% end %>
  <% end %>

  <% if can?(:index, Version) %>
    <div class="p font-bold">
      <%= link_to(
        t(".versions"),
        { controller: :versions, action: :index, user_id: @user&.id },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          { controller: :versions, action: :new, user_id: @user&.id },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: [@user]
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold">
      <%= link_to(
        t(".logs"),
        { controller: :logs, action: :index, user_id: @user&.id },
        class: :link
      ) %>
    </div>

    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          { controller: :logs, action: :new, user_id: @user&.id },
          class: "button"
        ) %>
      </div>
    <% end %>

    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: [@user]
      }
    ) %>
  <% end %>
<% end %>
