<%= form_for(show_url) do |f| %>
  <%= hidden_field_tag(:redirect_to, params[:redirect_to], autocomplete: :off) %>
  <% if admin? %>
    <div class="p">
      <%= f.label(:admin, class: :label) %>
      <%= f.check_box(:admin, autocomplete: :off, data: { form_type: :other }) %>
    </div>

    <div class="p">
      <%= f.label(:verified, class: :label) %>
      <%= f.check_box(:verified, autocomplete: :off, data: { form_type: :other }) %>
    </div>
  <% end %>

  <div class="p">
    <%= f.label(:locale, class: :label) %>
    <%= f.select(
      :locale,
      locale_options(locale: f.object.locale.presence || I18n.locale),
      {},
      required: true,
      class: :input,
      data: {
        form_type: :other
      },
      autocomplete: :off
    ) %>
  </div>

  <div class="p">
    <%= f.label(:interface, class: :label) %>
    <%= f.select(
      :interface,
      interface_options(interface: f.object.interface),
      {},
      required: true,
      class: :input,
      data: {
        form_type: :other
      },
      autocomplete: :off
    ) %>
  </div>

  <%= render("email_addresses/nested", f: f) %>
  <%= render("phone_numbers/nested", f: f) %>
  <%= render("passwords/nested", f: f) %>

  <div class="p">
    <%= f.submit(
      submit,
      class: "button",
      data: {
        controller: "bridge--button",
        bridge__button_title_value: submit
      }
    ) %>
  </div>
<% end %>
