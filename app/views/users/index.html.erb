<%= turbo_stream_from(@users) %>

<% if can?(:create, User) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @users.any? && (can?(:destroy_all, User) || can?(:delete_all, User)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, User) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, User) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(partial: "users/user", collection: @users, as: :user) %>
</turbo-frame>
