<%= form_for(show_url) do |f| %>
  <div class="p">
    <%= f.label(:user_id, class: :label) %>
    <%= f.select(
      :user_id,
      policy_scope(User).order(:id).map { |record| [record.to_s, record.id] },
      { include_blank: true },
      class: :input,
      autocomplete: :off,
      data: {
        form_type: :other
      }
    ) %>
  </div>

  <% %i[name_en name_fr description_en description_fr body_en body_fr].each do |attribute| %>
    <div class="p" data-turbo-permanent>
      <%= f.label(attribute, class: :label) %>
      <%= f.rich_textarea(
        attribute,
        class: "input lexxy-content",
        autocomplete: :off,
        data: {
          form_type: :other
        }
      ) %>
    </div>
  <% end %>

  <%= render("service_fields/nested", f: f) %>

  <div class="p">
    <%= f.submit(
      submit,
      class: "button",
      data: {
        controller: "bridge--button",
        bridge__button_title_value: submit
      }
    ) %>
  </div>
<% end %>
