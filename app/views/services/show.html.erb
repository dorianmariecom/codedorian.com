<% content_for(:title, @service) %>
<% content_for(:description, @service.description) %>
<%= turbo_stream_from(@service) %>

<% if (can?(:update, @service) || advanced?) && @service.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @service.id %></div>
  </div>
<% end %>

<% if (can?(:update, @service) || advanced?) && @service.user_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".user_id") %></div>
    <% association = @service.user %>
    <div class="font-bold">
      <%= link_to_if(can?(:show, association), association, association, class: :link) %>
    </div>
  </div>
<% end %>

<% if can?(:update, @service) || advanced? %>
  <% if @service.name_en.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".name_en") %></div>
      <%= @service.name_en %>
    </div>
  <% end %>
  <% if @service.name_fr.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".name_fr") %></div>
      <%= @service.name_fr %>
    </div>
  <% end %>
  <% if @service.description_en.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".description_en") %></div>
      <%= @service.description_en %>
    </div>
  <% end %>
  <% if @service.description_fr.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".description_fr") %></div>
      <%= @service.description_fr %>
    </div>
  <% end %>
  <% if @service.body_en.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".body_en") %></div>
      <%= @service.body_en %>
    </div>
  <% end %>
  <% if @service.body_fr.present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".body_fr") %></div>
      <%= @service.body_fr %>
    </div>
  <% end %>
<% else %>
  <% if @service.name.present? %>
    <div class="p font-bold"><%= @service.name %></div>
  <% end %>
  <% if @service.description.present? %>
    <div class="p italic"><%= @service.description %></div>
  <% end %>
  <% if @service.body.present? %>
    <div class="p"><%= @service.body %></div>
  <% end %>
  <% if @plans.any? %>
    <div class="p font-bold"><%= t(".plans") %></div>
    <%= render(partial: "plans/public_plan", collection: @plans, as: :plan) %>
    <% if @plans.total_pages > 1 %>
      <div class="p p--flex"><%= paginate(@plans) %></div>
    <% end %>
  <% end %>
<% end %>

<% if (can?(:update, @service) || advanced?) && @service.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@service.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if (can?(:update, @service) || advanced?) && @service.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@service.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if can?(:update, @service) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<% if can?(:update, @service) || advanced? %>
  <div class="p font-bold">
    <%= link_to(t(".steps"), steps_path(service_id: @service.id), class: :link) %>
  </div>
  <% if can?(:create, Step) %>
    <div class="p">
      <%= link_to(
        t(".new_step"),
        new_step_path(step: { service_id: @service.id }),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(partial: "steps/step", collection: @steps, as: :step) %>

  <div class="p font-bold">
    <%= link_to(t(".plans"), plans_path(service_id: @service.id), class: :link) %>
  </div>
  <% if can?(:create, Plan) %>
    <div class="p">
      <%= link_to(
        t(".new_plan"),
        new_plan_path(plan: { service_id: @service.id }),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(partial: "plans/plan", collection: @plans, as: :plan) %>

  <% if can?(:index, PlanField) %>
    <div class="p font-bold">
      <%= link_to(
        t(".plan_fields"),
        plan_fields_path(service_id: @service.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, PlanField) %>
      <div class="p">
        <%= link_to(t(".new_plan_field"), new_plan_field_path, class: "button") %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "plan_fields/plan_field",
      collection: @plan_fields,
      as: :plan_field
    ) %>
  <% end %>

  <% if can?(:index, ServiceField) %>
    <div class="p font-bold">
      <%= link_to(
        t(".service_fields"),
        service_fields_path(service_id: @service.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, ServiceField) %>
      <div class="p">
        <%= link_to(
          t(".new_service_field"),
          new_service_field_path(service_field: { service_id: @service.id }),
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "service_fields/service_field",
      collection: @service_fields,
      as: :service_field
    ) %>
  <% end %>

  <div class="p font-bold">
    <%= link_to(
      t(".subscriptions"),
      subscriptions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, Subscription) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription"),
        new_service_subscription_path(@service),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscriptions/subscription",
    collection: @subscriptions,
    as: :subscription
  ) %>

  <div class="p font-bold">
    <%= link_to(
      t(".subscription_executions"),
      subscription_executions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, SubscriptionExecution) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription_execution"),
        new_subscription_execution_path,
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_executions/subscription_execution",
    collection: @subscription_executions,
    as: :subscription_execution
  ) %>

  <div class="p font-bold">
    <%= link_to(
      t(".step_executions"),
      step_executions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, StepExecution) %>
    <div class="p">
      <%= link_to(t(".new_step_execution"), new_step_execution_path, class: "button") %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "step_executions/step_execution",
    collection: @step_executions,
    as: :step_execution
  ) %>

  <% if can?(:index, Version) %>
    <div class="p font-bold"><%= t(".versions") %></div>
    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          { controller: :versions, action: :new, service_id: @service.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: []
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold"><%= t(".logs") %></div>
    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          { controller: :logs, action: :new, service_id: @service.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: []
      }
    ) %>
  <% end %>
<% end %>
