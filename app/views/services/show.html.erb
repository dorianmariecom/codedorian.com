<% content_for(:title, @service) %>
<% content_for(:description, @service.description) %>
<%= turbo_stream_from(@service) %>

<% if (can?(:update, @service) || advanced?) %>
  <%= render("shared/attribute", label: t(".id"), value: @service.id) %>
<% end %>

<% if (can?(:update, @service) || advanced?) %>
  <%= render(
    "shared/attribute",
    label: t(".user_id"),
    value: @service.user,
    type: :record
  ) %>
<% end %>

<% if can?(:update, @service) || advanced? %>
  <%= render(
    "shared/attribute",
    label: t(".name_en"),
    value: @service.name_en,
    type: :content
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".name_fr"),
    value: @service.name_fr,
    type: :content
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".description_en"),
    value: @service.description_en,
    type: :content
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".description_fr"),
    value: @service.description_fr,
    type: :content
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".body_en"),
    value: @service.body_en,
    type: :content
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".body_fr"),
    value: @service.body_fr,
    type: :content
  ) %>
<% else %>
  <% if @service.name.present? %>
    <div class="p font-bold">
      <p>
        <b><%= @service.name.to_plain_text %></b>
      </p>
    </div>
  <% end %>
  <% if @service.description.present? %>
    <div class="p italic"><%= @service.description %></div>
  <% end %>
  <% if @plans.any? %>
    <%= render("services/plan_comparison", plans: @plans) %>
    <% if @plans.total_pages > 1 %>
      <div class="p p--flex"><%= paginate(@plans) %></div>
    <% end %>
  <% end %>
  <% if @service.body.present? %>
    <p class="p">
      <b><%= t(".how_it_works") %></b>
    </p>
    <div class="p"><%= @service.body %></div>
  <% end %>
<% end %>

<% if (can?(:update, @service) || advanced?) %>
  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @service.updated_at,
    type: :time
  ) %>
<% end %>

<% if (can?(:update, @service) || advanced?) %>
  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @service.created_at,
    type: :time
  ) %>
<% end %>

<% if can?(:update, @service) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<% if can?(:update, @service) || advanced? %>
  <div class="p font-bold">
    <%= link_to(t(".steps"), steps_path(service_id: @service.id), class: :link) %>
  </div>
  <% if can?(:create, Step) %>
    <div class="p">
      <%= link_to(
        t(".new_step"),
        new_step_path(step: { service_id: @service.id }),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(partial: "steps/step", collection: @steps, as: :step) %>

  <div class="p font-bold">
    <%= link_to(t(".plans"), plans_path(service_id: @service.id), class: :link) %>
  </div>
  <% if can?(:create, Plan) %>
    <div class="p">
      <%= link_to(
        t(".new_plan"),
        new_plan_path(plan: { service_id: @service.id }),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(partial: "plans/plan", collection: @plans, as: :plan) %>

  <% if can?(:index, PlanField) %>
    <div class="p font-bold">
      <%= link_to(
        t(".plan_fields"),
        plan_fields_path(service_id: @service.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, PlanField) %>
      <div class="p">
        <%= link_to(t(".new_plan_field"), new_plan_field_path, class: "button") %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "plan_fields/plan_field",
      collection: @plan_fields,
      as: :plan_field
    ) %>
  <% end %>

  <% if can?(:index, ServiceField) %>
    <div class="p font-bold">
      <%= link_to(
        t(".service_fields"),
        service_fields_path(service_id: @service.id),
        class: :link
      ) %>
    </div>
    <% if can?(:create, ServiceField) %>
      <div class="p">
        <%= link_to(
          t(".new_service_field"),
          new_service_field_path(service_field: { service_id: @service.id }),
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "service_fields/service_field",
      collection: @service_fields,
      as: :service_field
    ) %>
  <% end %>

  <div class="p font-bold">
    <%= link_to(
      t(".subscriptions"),
      subscriptions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, Subscription) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription"),
        new_service_subscription_path(@service),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscriptions/subscription",
    collection: @subscriptions,
    as: :subscription
  ) %>

  <div class="p font-bold">
    <%= link_to(
      t(".subscription_executions"),
      subscription_executions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, SubscriptionExecution) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription_execution"),
        new_subscription_execution_path,
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_executions/subscription_execution",
    collection: @subscription_executions,
    as: :subscription_execution
  ) %>

  <div class="p font-bold">
    <%= link_to(
      t(".step_executions"),
      step_executions_path(service_id: @service.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, StepExecution) %>
    <div class="p">
      <%= link_to(t(".new_step_execution"), new_step_execution_path, class: "button") %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "step_executions/step_execution",
    collection: @step_executions,
    as: :step_execution
  ) %>

  <% if can?(:index, Version) %>
    <div class="p font-bold"><%= t(".versions") %></div>
    <% if can?(:create, Version) %>
      <div class="p">
        <%= link_to(
          t(".new_version"),
          { controller: :versions, action: :new, service_id: @service.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "versions/version",
      collection: @versions,
      as: :version,
      locals: {
        nested: []
      }
    ) %>
  <% end %>

  <% if can?(:index, Log) %>
    <div class="p font-bold"><%= t(".logs") %></div>
    <% if can?(:create, Log) %>
      <div class="p">
        <%= link_to(
          t(".new_log"),
          { controller: :logs, action: :new, service_id: @service.id },
          class: "button"
        ) %>
      </div>
    <% end %>
    <%= render_collection(
      partial: "logs/log",
      collection: @logs,
      as: :log,
      locals: {
        nested: []
      }
    ) %>
  <% end %>
<% end %>
