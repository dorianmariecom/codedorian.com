<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@services) %>

<% if can?(:index, Step) %>
  <div class="p">
    <%= link_to(t(".steps", count: @steps.count), steps_path, class: :link) %>
  </div>
<% end %>
<% if can?(:index, Plan) %>
  <div class="p">
    <%= link_to(t(".plans", count: @plans.count), plans_path, class: :link) %>
  </div>
<% end %>
<% if can?(:index, PlanField) %>
  <div class="p">
    <%= link_to(
      t(".plan_fields", count: @plan_fields.count),
      plan_fields_path,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, ServiceField) %>
  <div class="p">
    <%= link_to(
      t(".service_fields", count: @service_fields.count),
      service_fields_path,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, Subscription) %>
  <div class="p">
    <%= link_to(
      t(".subscriptions", count: @subscriptions.count),
      subscriptions_path,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, SubscriptionExecution) %>
  <div class="p">
    <%= link_to(
      t(".subscription_executions", count: @subscription_executions.count),
      subscription_executions_path,
      class: :link
    ) %>
  </div>
<% end %>
<% if can?(:index, StepExecution) %>
  <div class="p">
    <%= link_to(
      t(".step_executions", count: @step_executions.count),
      step_executions_path,
      class: :link
    ) %>
  </div>
<% end %>

<% if can?(:create, Service) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @services.any? && can?(:destroy_all, Service) %>
    <div class="p p--flex">
      <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "services/service",
    collection: @services,
    as: :service
  ) %>
</turbo-frame>
