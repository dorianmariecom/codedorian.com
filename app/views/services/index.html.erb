<% content_for(:description, t(".title")) %>
<%= turbo_stream_from(@services) %>

<% if can?(:index, ServiceField) %>
  <%
    records = policy_scope(ServiceField)
    records = records.where_user(@user) if @user
  %>
  <%= render(
    "shared/count",
    records: records,
    translation: "service_fields",
    url: {
      controller: :service_fields,
      action: :index,
      user_id: @user&.id
    }.compact
  ) %>
<% end %>
