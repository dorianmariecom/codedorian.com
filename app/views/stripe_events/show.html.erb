<% content_for(:title, @stripe_event) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@stripe_event) %>

<% %i[id stripe_event_id event_type status].each do |attribute| %>
  <% if @stripe_event.public_send(attribute).present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".#{attribute}") %></div>
      <div class="font-bold"><%= @stripe_event.public_send(attribute) %></div>
    </div>
  <% end %>
<% end %>

<div class="p">
  <div class="text-gray-600"><%= t(".livemode") %></div>
  <div class="font-bold"><%= @stripe_event.livemode %></div>
</div>

<% %i[stripe_created_at processed_at updated_at created_at].each do |attribute| %>
  <% if @stripe_event.public_send(attribute).present? %>
    <div class="p">
      <div class="text-gray-600"><%= t(".#{attribute}") %></div>
      <div class="font-bold">
        <%= local_time(@stripe_event.public_send(attribute), format: :default) %>
      </div>
    </div>
  <% end %>
<% end %>

<% if @stripe_event.processing_error.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".processing_error") %></div>
    <div class="font-bold"><%= @stripe_event.processing_error %></div>
  </div>
<% end %>

<div class="p">
  <div class="text-gray-600"><%= t(".payload") %></div>
  <%= json_highlight(@stripe_event.payload_json) %>
</div>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: { nested: [] }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: { nested: [] }
  ) %>
<% end %>
