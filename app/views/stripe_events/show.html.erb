<% content_for(:title, @stripe_event) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@stripe_event) %>

<% %i[id stripe_event_id event_type status].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @stripe_event.public_send(attribute)
  ) %>
<% end %>

<%= render("shared/attribute", label: t(".livemode"), value: @stripe_event.livemode) %>

<% %i[stripe_created_at processed_at updated_at created_at].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @stripe_event.public_send(attribute),
    type: :time
  ) %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".processing_error"),
  value: @stripe_event.processing_error
) %>

<%= render(
  "shared/attribute",
  label: t(".payload"),
  value: @stripe_event.payload_json,
  type: :json
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
