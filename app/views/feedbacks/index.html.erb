<% content_for(:title, t(".title")) %>

<%= turbo_stream_from(@feedbacks) %>

<% if can?(:create, Feedback) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @feedbacks.any? && (can?(:destroy_all, Feedback) || can?(:delete_all, Feedback)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Feedback) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Feedback) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "feedbacks/feedback",
    collection: @feedbacks,
    as: :feedback
  ) %>
</turbo-frame>
