<% content_for(:title, @connection) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@connection) %>
<%= render("shared/attribute", label: t(".id"), value: @connection.id) %>
<%= render("shared/attribute", label: t(".user_id"), value: @connection.user_id) %>
<%= render("shared/attribute", label: t(".email"), value: @connection.email) %>
<%= render("shared/attribute", label: t(".username"), value: @connection.username) %>
<%= render(
  "shared/attribute",
  label: t(".external_id"),
  value: @connection.external_id
) %>
<%= render("shared/attribute", label: t(".provider"), value: @connection.provider) %>
<%= render("shared/attribute", label: t(".enabled"), value: @connection.enabled) %>
<%= render(
  "shared/attribute",
  label: t(".access_token"),
  value: @connection.access_token,
  type: admin? ? :text : :password
) %>
<%= render("shared/attribute", label: t(".base_url"), value: @connection.base_url) %>
<%= render(
  "shared/attribute",
  label: t(".account_sid"),
  value: @connection.account_sid
) %>
<%= render(
  "shared/attribute",
  label: t(".auth_token"),
  value: @connection.auth_token,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".api_key"),
  value: @connection.api_key,
  type: admin? ? :text : :password
) %>
<%= render("shared/attribute", label: t(".sender"), value: @connection.sender) %>
<%= render("shared/attribute", label: t(".smtp_from"), value: @connection.smtp_from) %>
<%= render(
  "shared/attribute",
  label: t(".smtp_address"),
  value: @connection.smtp_address
) %>
<%= render("shared/attribute", label: t(".smtp_port"), value: @connection.smtp_port) %>
<%= render(
  "shared/attribute",
  label: t(".smtp_user_name"),
  value: @connection.smtp_user_name
) %>
<%= render(
  "shared/attribute",
  label: t(".smtp_password"),
  value: @connection.smtp_password,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".smtp_authentication"),
  value: @connection.smtp_authentication
) %>
<%= render(
  "shared/attribute",
  label: t(".refresh_token"),
  value: @connection.refresh_token,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".token_expires_at"),
  value: @connection.token_expires_at
) %>
<%= render(
  "shared/attribute",
  label: t(".aws_access_key_id"),
  value: @connection.aws_access_key_id,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".aws_secret_access_key"),
  value: @connection.aws_secret_access_key,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".aws_session_token"),
  value: @connection.aws_session_token,
  type: admin? ? :text : :password
) %>
<%= render(
  "shared/attribute",
  label: t(".aws_region"),
  value: @connection.aws_region
) %>
<%= render(
  "shared/attribute",
  label: t(".mailgun_domain"),
  value: @connection.mailgun_domain
) %>
<%= render(
  "shared/attribute",
  label: t(".mailgun_region"),
  value: @connection.mailgun_region
) %>
<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @connection.created_at,
  type: :time
) %>
<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @connection.updated_at,
  type: :time
) %>

<div class="p p--flex">
  <% if can?(:update, @connection) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @connection) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @connection) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              connection_id: @connection.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              { controller: :versions, action: :new, connection_id: @connection.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @connection]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            { controller: :logs, action: :index, connection_id: @connection.id },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              { controller: :logs, action: :new, connection_id: @connection.id },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @connection]
    }
  ) %>
<% end %>
