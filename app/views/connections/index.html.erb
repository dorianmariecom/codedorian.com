<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@connections) %>

<% if can?(:index, DeliveryChannel) %>
  <%
    records = policy_scope(DeliveryChannel)
    records = records.where_user(@user) if @user
  %>
  <div class="p">
    <%= link_to(
      t(".delivery_channels", count: records.distinct.count),
      {
        controller: :delivery_channels,
        action: :index,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>
