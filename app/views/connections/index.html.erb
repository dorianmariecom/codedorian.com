<% if can?(:create, Connection) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<% ConnectionOauth::PROVIDERS.each do |provider| %>
  <% if can?(:connect, Connection.new(user: current_user, provider: provider)) %>
    <%= form_with url: connect_connections_path(provider: provider),
              data: {
                turbo: false
              },
              class: :p do |f| %>
      <% if provider == "mastodon" %>
        <div class="flex gap-4 items-end">
          <div>
            <%= f.label :server, t(".server"), class: :label %>
            <%= f.url_field :server, required: true, class: :input %>
          </div>
          <div>
            <%= f.submit t(".connect", provider: t("connections.model.providers.#{provider}")),
                     class: :button %>
          </div>
        </div>
      <% elsif provider == "google" %>
        <div class="p">
          <%= f.check_box :scope,
                      { id: "#{provider}_calendar_access", checked: false },
                      MailboxOauth::GOOGLE_CALENDAR_SCOPES.join(" "),
                      "" %>
          <%= f.label :scope, t(".calendar_access"), for: "#{provider}_calendar_access" %>
        </div>
        <%= f.submit t(".connect", provider: t("connections.model.providers.#{provider}")),
                 class: :button %>
      <% else %>
        <%= f.submit t(".connect", provider: t("connections.model.providers.#{provider}")),
                 class: :button %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @connections.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, Connection) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, Connection) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "connections/connection",
    collection: @connections,
    as: :connection
  ) %>
</turbo-frame>
