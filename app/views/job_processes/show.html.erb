<% content_for(:title, @job_process) %>

<%= turbo_stream_from(@job_process) %>

<%= render("shared/attribute", label: t(".id"), value: @job_process.id) %>

<%= render("shared/attribute", label: t(".name"), value: @job_process.name) %>

<%= render("shared/attribute", label: t(".hostname"), value: @job_process.hostname) %>

<%= render("shared/attribute", label: t(".kind"), value: @job_process.kind) %>

<%= render("shared/attribute", label: t(".pid"), value: @job_process.pid) %>

<%= render(
  "shared/attribute",
  label: t(".supervisor_id"),
  value: @job_process.supervisor_id
) %>

<%= render(
  "shared/attribute",
  label: t(".last_heartbeat_at"),
  value: @job_process.last_heartbeat_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".metadata"),
  value: @job_process.metadata_json,
  type: :json
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @job_process.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @job_process.created_at,
  type: :time
) %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, job_process_id: @job_process&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, job_process_id: @job_process&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [@job_process]
    }
  ) %>
<% end %>
