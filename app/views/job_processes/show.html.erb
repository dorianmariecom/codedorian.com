        .where_job_process(@job_process)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job_claimed_execution,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, JobContext) %>
  <div class="p font-bold">
    <%= link_to(
      t(".job_contexts"),
      {
        controller: :job_contexts,
        action: :index,
        job_process_id: @job_process.id
      },
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "job_contexts/job_context",
    collection:
      policy_scope(JobContext)
        .where_job_process(@job_process)
        .distinct
        .order(created_at: :desc)
        .page(params[:page]),
    as: :job_context,
    locals: {
      nested: []
    }
  ) %>
<% end %>
