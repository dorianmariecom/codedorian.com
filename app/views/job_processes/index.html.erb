<%= turbo_stream_from(@job_processes) %>

<% if can?(:create, JobProcess) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @job_processes.any? &&
    (can?(:destroy_all, JobProcess) || can?(:delete_all, JobProcess)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, JobProcess) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, JobProcess) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "job_processes/job_process",
    collection: @job_processes,
    as: :job_process
  ) %>
</turbo-frame>
