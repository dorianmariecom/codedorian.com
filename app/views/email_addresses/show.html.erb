<% content_for(:title, @email_address) %>

<%= turbo_stream_from(@email_address) %>

<% if @email_address.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @email_address.id %></div>
  </div>
<% end %>

<% if @email_address.user.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".user") %></div>
    <%= render("shared/user", user: @email_address.user) %>
  </div>
<% end %>

<% if @email_address.email_address.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".email_address") %></div>
    <strong class="font-bold"><%= @email_address.email_address %></strong>
  </div>
<% end %>

<% if @email_address.primary.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".primary") %></div>
    <div class="font-bold"><%= @email_address.primary? %></div>
  </div>
<% end %>

<div class="p">
  <div>
    <%= t(
      (
        if @email_address.verified?
          ".verified"
        else
          ".unverified"
        end
      )
    ) %>
  </div>
  <% unless @email_address.verified? %>
    <%= button_to(
      t(".request_verification"),
      request_verification_email_address_path(id: @email_address),
      class: :button
    ) %>
  <% end %>
</div>

<% if @email_address.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <strong class="font-bold">
      <%= local_time(@email_address.updated_at, format: :default) %>
    </strong>
  </div>
<% end %>

<% if @email_address.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <strong class="font-bold">
      <%= local_time(@email_address.created_at, format: :default) %>
    </strong>
  </div>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) if can?(:update, @email_address) %>
  <%= if can?(:destroy, @email_address)
    render("shared/confirm", text: t(".destroy"), url: destroy_url)
  end %>
  <%= if can?(:delete, @email_address)
    render("shared/confirm", text: t(".delete"), url: delete_url)
  end %>
</div>

<% if can?(:index, Job) %>
  <% jobs =
    policy_scope(Job)
      .where_email_address(@email_address)
      .order(created_at: :desc)
      .page(params[:page]) %>

  <div class="p font-bold">
    <%= link_to(t(".jobs"), { controller: :jobs, action: :index }, class: :link) %>
  </div>

  <% if can?(:create, Job) %>
    <div class="p">
      <%= link_to(t(".new_job"), { controller: :jobs, action: :new }, class: "button") %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "jobs/job",
    collection: jobs,
    as: :job,
    locals: {
      nested: jobs_nested
    }
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to(
      t(".versions"),
      {
        controller: :versions,
        action: :index,
        email_address_id: @email_address&.id
      },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        { controller: :versions, action: :new, email_address_id: @email_address&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @email_address]
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to(
      t(".logs"),
      { controller: :logs, action: :index, email_address_id: @email_address&.id },
      class: :link
    ) %>
  </div>

  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, email_address_id: @email_address&.id },
        class: "button"
      ) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @email_address]
    }
  ) %>
<% end %>
