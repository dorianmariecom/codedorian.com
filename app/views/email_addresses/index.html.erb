<%= turbo_stream_from(@email_addresses) %>

<% if can?(:create, EmailAddress) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>

<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @email_addresses.any? &&
    (can?(:destroy_all, EmailAddress) || can?(:delete_all, EmailAddress)) %>
    <div class="p p--flex">
      <% if can?(:destroy_all, EmailAddress) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, EmailAddress) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "email_addresses/email_address",
    collection: @email_addresses,
    as: :email_address
  ) %>
</turbo-frame>
