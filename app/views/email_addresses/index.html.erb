<%= turbo_stream_from(@email_addresses) %>

<% if can?(:index, Job) %>
  <%
    records = policy_scope(Job)
    if @user
      records = records.where_user(@user)
    elsif @guest
      records = records.where_guest(@guest)
    end
  %>
  <div class="p">
    <%= link_to(
      t(".jobs", count: records.distinct.count),
      {
        controller: :jobs,
        action: :index,
        guest_id: @guest&.id,
        user_id: @user&.id
      }.compact,
      class: :link
    ) %>
  </div>
<% end %>
