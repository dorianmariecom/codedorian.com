<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @subscriptions.any? && can?(:destroy_all, Subscription) %>
    <div class="p p--flex">
      <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
    </div>
  <% end %>

  <%= render_collection(
    partial: "subscriptions/subscription",
    collection: @subscriptions,
    as: :subscription
  ) %>
</turbo-frame>
