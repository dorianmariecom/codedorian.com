<% content_for(:title, @subscription) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@subscription) %>

<% if (admin? || advanced?) %>
  <%= render(
    "shared/attribute",
    label: t(".heartbeats_url"),
    value: @subscription.heartbeats_url,
    type: :link
  ) %>
<% end %>

<%= render("shared/attribute", label: t(".id"), value: @subscription.id) %>

<%= render(
  "shared/attribute",
  label: t(".user_id"),
  value: @subscription.user,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".plan_id"),
  value: @subscription.plan,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".service"),
  value: @subscription.service,
  type: :record
) %>

<%= render(
  "shared/attribute",
  label: t(".status"),
  value: @subscription.translated_status
) %>

<div class="p">
  <%= link_to(t(".billing"), subscription_billing_path(@subscription), class: :link) %>
</div>

<% @subscription
  .subscription_destinations
  .selected
  .preload(delivery_destination: :delivery_channel)
  .each do |selection| %>
  <% destination = selection.delivery_destination %>
  <% if destination.verification_required? %>
    <div class="p">
      <div class="font-bold"><%= destination.recipient %></div>
      <div>
        <%= t(
          (
            if destination.recipient_verified?
              ".recipient_verified"
            else
              ".recipient_unverified"
            end
          )
        ) %>
      </div>
      <% unless destination.recipient_verified? %>
        <p><%= t(".delivery_pending") %></p>
        <%= button_to(
          t(".request_verification"),
          request_verification_subscription_delivery_destination_path(
            subscription_id: @subscription.id,
            id: destination.id
          ),
          class: :button
        ) %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if !admin? && !advanced? %>
  <% @subscription.plan.fields.each do |field| %>
    <% subscription_value = @subscription.values[field.key] %>
    <% if subscription_value&.value.present? %>
      <%= render("shared/attribute", label: field.name, value: subscription_value.value) %>
    <% end %>
  <% end %>
<% end %>

<%= render(
  "shared/attribute",
  label: t(".starts_at"),
  value: @subscription.starts_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".previous_at"),
  value: @subscription.previous_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".next_at"),
  value: @subscription.next_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @subscription.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @subscription.created_at,
  type: :time
) %>

<% if can?(:evaluate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".evaluate"),
      url: [:evaluate, *show_url],
      method: :post,
      class: "button"
    ) %>
  </div>
<% end %>

<% if @subscription.active? && can?(:deactivate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".deactivate"),
      url: [:deactivate, *show_url],
      method: :post
    ) %>
  </div>
<% elsif @subscription.inactive? && can?(:activate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".activate"),
      url: [:activate, *show_url],
      method: :post
    ) %>
  </div>
<% end %>

<div class="p p--flex">
  <% if can?(:update, @subscription) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @subscription) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @subscription) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>

<% if can?(:index, SubscriptionExecution) %>
  <div class="p font-bold">
    <%= link_to(
      t(".subscription_executions"),
      subscription_executions_path(subscription_id: @subscription.id),
      class: :link
    ) %>
  </div>
  <% if can?(:create, SubscriptionExecution) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription_execution"),
        new_subscription_execution_path(
          subscription_execution: {
            subscription_id: @subscription.id
          }
        ),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_executions/subscription_execution",
    collection: @subscription_executions,
    as: :subscription_execution
  ) %>
<% end %>

<% if can?(:index, StepExecution) %>
  <div class="p font-bold">
    <%= link_to(
      t(".step_executions"),
      step_executions_path(subscription_id: @subscription.id),
      class: :link
    ) %>
  </div>
  <%= render_collection(
    partial: "step_executions/step_execution",
    collection: @step_executions,
    as: :step_execution
  ) %>
<% end %>

<% if can?(:index, SubscriptionValue) %>
  <div class="p font-bold">
    <%= link_to(
      t(".subscription_values"),
      subscription_values_path(subscription_id: @subscription.id),
      class: :link
    ) %>
  </div>
  <% subscription_value = SubscriptionValue.new(subscription: @subscription) %>
  <% if can?(:create, subscription_value) %>
    <div class="p">
      <%= link_to(
        t(".new_subscription_value"),
        new_subscription_value_path(
          subscription_value: {
            subscription_id: @subscription.id
          }
        ),
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "subscription_values/subscription_value",
    collection: @subscription_values,
    as: :subscription_value
  ) %>
<% end %>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to(
        t(".new_version"),
        { controller: :versions, action: :new, subscription_id: @subscription.id },
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to(
        t(".new_log"),
        { controller: :logs, action: :new, subscription_id: @subscription.id },
        class: "button"
      ) %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
