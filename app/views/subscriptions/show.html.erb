<% content_for(:title, @subscription) %>
<% content_for(:description, @subscription.to_s) %>
<%= turbo_stream_from(@subscription) %>

<% if @subscription.id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold"><%= @subscription.id %></div>
  </div>
<% end %>

<% if @subscription.user_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".user_id") %></div>
    <% association = @subscription.user %>
    <div class="font-bold">
      <%= link_to_if(can?(:show, association), association, association, class: :link) %>
    </div>
  </div>
<% end %>

<% if @subscription.plan_id.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".plan_id") %></div>
    <% association = @subscription.plan %>
    <div class="font-bold">
      <%= link_to_if(can?(:show, association), association, association, class: :link) %>
    </div>
  </div>
<% end %>

<% if @subscription.status.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".status") %></div>
    <div class="font-bold"><%= @subscription.translated_status %></div>
  </div>
<% end %>

<% if @subscription.starts_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".starts_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription.starts_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription.previous_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".previous_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription.previous_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription.next_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".next_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription.next_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription.updated_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription.updated_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if @subscription.created_at.present? %>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold">
      <%= local_time(@subscription.created_at, format: :default) %>
    </div>
  </div>
<% end %>

<% if can?(:evaluate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".evaluate"),
      url: [:evaluate, *show_url],
      method: :post,
      class: "button"
    ) %>
  </div>
<% end %>

<% if @subscription.active? && can?(:deactivate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".deactivate"),
      url: [:deactivate, *show_url],
      method: :post
    ) %>
  </div>
<% elsif @subscription.inactive? && can?(:activate, @subscription) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      text: t(".activate"),
      url: [:activate, *show_url],
      method: :post
    ) %>
  </div>
<% end %>

<div class="p p--flex">
  <%= link_to(t(".edit"), edit_url, class: :link) %>
  <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
</div>

<div class="p font-bold">
  <%= link_to(
    t(".subscription_executions"),
    subscription_executions_path,
    class: :link
  ) %>
</div>
<% if can?(:create, SubscriptionExecution) %>
  <div class="p">
    <%= link_to(
      t(".new_subscription_execution"),
      new_subscription_execution_path(
        subscription_execution: {
          subscription_id: @subscription.id
        }
      ),
      class: "button"
    ) %>
  </div>
<% end %>
<%= render_collection(
  partial: "subscription_executions/subscription_execution",
  collection: @subscription_executions,
  as: :subscription_execution
) %>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
