<% quote = f.object.delivery_preview || f.object.delivery_pricing %>
<% channels = policy_scope(DeliveryChannel).order(:id).select(&:available?) %>
<% if channels.any? %>
  <div
    data-controller="nested"
    data-nested-selector-value=".subscription-delivery-destination"
  >
    <template data-nested-target="template">
      <%= f.fields_for(
        :delivery_destinations,
        DeliveryDestination.new,
        child_index: "NEW_RECORD"
      ) do |destination_f| %>
        <%= render "subscriptions/destination_fields", f: destination_f, channels: channels %>
      <% end %>
    </template>
    <%= f.fields_for(:delivery_destinations) do |destination_f| %>
      <%= render "subscriptions/destination_fields", f: destination_f, channels: channels %>
    <% end %>
    <div data-nested-target="target"></div>
    <div class="p">
      <button type="button" class="link" data-action="nested#add">
        <%= t(".add_destination") %>
      </button>
    </div>
  </div>
<% else %>
  <p class="p"><%= t(".unavailable") %></p>
<% end %>
<% if quote.present? %>
  <% quote.fetch("items", []).each do |item| %>
    <div class="p">
      <%= item["name"] %>: <%= subscription_price(item["amount_cents"], quote["amount_currency"]) %>
    </div>
  <% end %>
  <div class="p">
    <%= t(".base") %>: <%= subscription_price(quote["base_amount_cents"], quote["amount_currency"]) %>
  </div>
  <div class="p font-bold">
    <%= t(".total") %>: <%= subscription_price(quote["amount_cents"], quote["amount_currency"], total: true) %>
  </div>
<% end %>
<% if f.object.delivery_change_key.present? %>
  <p class="p"><%= t(".change_pending") %></p>
<% end %>
