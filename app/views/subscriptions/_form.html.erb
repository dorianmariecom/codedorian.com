<%= form_for(show_url) do |f| %>
  <div class="p">
    <%= f.label(:user_id, class: :label) %>
      <%= f.select(:user_id, policy_scope(User).order(:id).map { |record| [record.to_s, record.id] }, { include_blank: true }, class: :input, autocomplete: :off, data: { form_type: :other }) %>
  </div>

  <div class="p">
    <%= f.label(:plan_id, class: :label) %>
      <%= f.select(:plan_id, policy_scope(Plan).order(:id).map { |record| [record.to_s, record.id] }, {}, required: true, class: :input, autocomplete: :off, data: { form_type: :other }) %>
  </div>

  <div class="p">
    <%= f.label(:status, class: :label) %>
      <%= f.select(:status, Subscription::STATUSES, {}, required: true, class: :input) %>
  </div>

  <div class="p">
    <%= f.submit(submit, class: "button", data: { controller: "bridge--button", bridge__button_title_value: submit }) %>
  </div>
<% end %>
