<%= form_for(show_url) do |f| %>
  <% if admin? %>
    <div class="p">
      <%= f.label(:user_id, class: :label) %>
      <%= f.select(
        :user_id,
        policy_scope(User).order(:id).map { |record| [record.to_s, record.id] },
        { include_blank: true },
        class: :input,
        autocomplete: :off
      ) %>
    </div>
  <% end %>

  <% if admin? && f.object.persisted? %>
    <div class="p">
      <%= f.label(:plan_id, class: :label) %>
      <%= f.select(
        :plan_id,
        policy_scope(Plan).order(:id).map { |record| [record.to_s, record.id] },
        {},
        required: true,
        class: :input,
        autocomplete: :off
      ) %>
    </div>
  <% else %>
    <%= f.hidden_field(
      :plan_id,
      id: :subscription_selected_plan_id,
      autocomplete: :off
    ) %>
  <% end %>

  <% values = f.object.subscription_values.index_by(&:key) %>
  <% (f.object.plan&.fields || []).each do |field| %>
    <% value = values[field.key] || f.object.subscription_values.build(key: field.key) %>
    <%= f.fields_for(:subscription_values, value) do |value_f| %>
      <%= value_f.hidden_field(:id, autocomplete: :off) %>
      <%= value_f.hidden_field(:key, autocomplete: :off) %>
      <div class="p">
        <%= value_f.label(
          :value,
          field.name,
          class: :label,
          data: field.phone_number? ? { phone_number_target: :label } : {}
        ) %>
        <% if field.email_address? %>
          <div
            data-controller="validation"
            data-validation-trim-value="true"
            data-validation-gender-value="feminine"
          >
            <%= value_f.email_field(
              :value,
              required: field.required?,
              class: :input,
              autocomplete: field.autocomplete,
              data: {
                validation_target: :input,
                action: "validation#input",
                form_type: :other
              }
            ) %>
            <div
              class="text-red-600"
              hidden
              data-validation-target="error"
            ></div>
          </div>
        <% elsif field.phone_number? %>
          <div class="max-w-xs" data-controller="phone-number">
            <%= value_f.hidden_field(
              :value,
              autocomplete: :off,
              data: {
                phone_number_target: :hidden,
                form_type: :other
              }
            ) %>
            <%= value_f.phone_field(
              :value_input,
              value: value_f.object.value,
              required: field.required?,
              class: :input,
              autocomplete: field.autocomplete,
              data: {
                phone_number_target: :input,
                action: "phone-number#input",
                form_type: :other
              }
            ) %>
            <div
              class="text-red-600"
              hidden
              data-phone-number-target="error"
            ></div>
          </div>
        <% elsif field.number? %>
          <%= value_f.number_field(
            :value,
            step: :any,
            required: field.required?,
            class: :input,
            autocomplete: field.autocomplete
          ) %>
        <% elsif field.boolean? %>
          <%= value_f.check_box(:value, {}, "true", "false") %>
        <% elsif field.date? %>
          <%= value_f.date_field(
            :value,
            required: field.required?,
            class: :input,
            autocomplete: field.autocomplete
          ) %>
        <% else %>
          <%= value_f.text_field(
            :value,
            required: field.required?,
            class: :input,
            autocomplete: field.autocomplete
          ) %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <% if admin? %>
    <div class="p">
      <%= f.label(:status, class: :label) %>
      <%= f.select(:status, Subscription::STATUSES, {}, required: true, class: :input) %>
    </div>
  <% end %>

  <div class="p">
    <%= f.submit(
      submit,
      class: "button",
      data: {
        controller: "bridge--button",
        bridge__button_title_value: submit
      }
    ) %>
  </div>
<% end %>
