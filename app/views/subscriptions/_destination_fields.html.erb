<% channel = channels.find { |record| record.id == f.object.delivery_channel_id } %>
<div
  class="subscription-delivery-destination border-l border-black pl-5"
  data-new-record="<%= f.object.new_record? %>"
  data-controller="delivery-destination-form"
  data-action="turbo:morph@document->delivery-destination-form#change"
>
  <%= f.hidden_field :_destroy %>
  <div class="p">
    <%= f.label :delivery_channel_id, class: :label %>
    <%= f.select :delivery_channel_id,
             channels.map { |channel|
               [
                 "#{channel} (#{subscription_price(channel.amount_cents, channel.amount_currency)})",
                 channel.id,
                 { data: delivery_channel_form_data(channel) }
               ]
             },
             { include_blank: true },
             required: true,
             class: :input,
             data: {
               action: "change->delivery-destination-form#change",
               "delivery-destination-form-target": "channel"
             } %>
  </div>
  <%= content_tag :div,
              class: :p,
              hidden: !channel&.show_recipient?,
              data: {
                "delivery-destination-form-target": "recipientRow"
              } do %>
    <%= f.label :recipient, class: :label %>
    <%= f.text_field :recipient,
                 class: :input,
                 autocomplete: :off,
                 data: {
                   "delivery-destination-form-target": "recipient"
                 } %>
  <% end %>
  <%= content_tag :div,
              class: :p,
              hidden: !channel&.show_connection?,
              data: {
                "delivery-destination-form-target": "connectionRow"
              } do %>
    <% connections =
      delivery_connection_options(
        delivery_connection_id: f.object.delivery_connection_id
      ) %>
    <template data-delivery-destination-form-target="connectionOptions">
      <%= options_for_select(connections) %>
    </template>
    <%= f.label :delivery_connection_id, class: :label %>
    <%= f.select :delivery_connection_id,
             connections.select { |option|
               channel &&
                 DeliveryChannel.supports_provider?(
                   channel.key,
                   option[2][:data][:"delivery-destination-form-provider"]
                 )
             },
             { include_blank: true },
             class: :input,
             data: {
               "delivery-destination-form-target": "connection"
             } %>
  <% end %>
  <%= content_tag :div,
              class: :p,
              hidden: !channel&.show_visibility?,
              data: {
                "delivery-destination-form-target": "visibilityRow"
              } do %>
    <%= f.label :visibility, class: :label %>
    <%= f.select :visibility,
             [[t(".private"), "private"], [t(".public"), "public"]],
             {},
             class: :input,
             data: {
               action: "change->delivery-destination-form#change",
               "delivery-destination-form-target": "visibility"
             } %>
  <% end %>
  <div class="p">
    <button type="button" class="link" data-action="nested#remove">
      <%= t(".remove") %>
    </button>
  </div>
</div>
