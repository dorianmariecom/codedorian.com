<div
  class="subscription-delivery-destination border-l border-black pl-5"
  data-new-record="<%= f.object.new_record? %>"
  data-controller="delivery-destination-form"
>
  <%= f.hidden_field :_destroy %>
  <div class="p">
    <%= f.label :delivery_channel_id, class: :label %>
    <%= f.select :delivery_channel_id,
             channels.map { |channel|
               [
                 "#{channel} · #{number_to_currency(channel.amount_cents / 100.0, unit: channel.amount_currency.upcase)} / #{t(".month")}",
                 channel.id,
                 {
                   data: {
                     "delivery-destination-form-channel": channel.key,
                     "delivery-destination-form-show-recipient":
                       channel.show_recipient,
                     "delivery-destination-form-show-visibility":
                       channel.show_visibility
                   }
                 }
               ]
             },
             { include_blank: true },
             required: true,
             class: :input,
             data: {
               action: "change->delivery-destination-form#change",
               "delivery-destination-form-target": "channel"
             } %>
  </div>
  <div class="p" data-delivery-destination-form-target="recipientRow">
    <%= f.label :recipient, class: :label %>
    <%= f.text_field :recipient,
                 class: :input,
                 autocomplete: :off,
                 data: {
                   "delivery-destination-form-target": "recipient"
                 } %>
  </div>
  <% if connections.any? %>
    <div class="p">
      <%= f.label :delivery_connection_id, class: :label %>
      <%= f.select :delivery_connection_id,
               connections.map { |connection| [connection.name, connection.id] },
               { include_blank: true },
               class: :input %>
    </div>
  <% end %>
  <div class="p" data-delivery-destination-form-target="visibilityRow">
    <%= f.label :visibility, class: :label %>
    <%= f.select :visibility,
             [[t(".private"), "private"], [t(".public"), "public"]],
             {},
             class: :input,
             data: {
               action: "change->delivery-destination-form#change",
               "delivery-destination-form-target": "visibility"
             } %>
  </div>
  <div class="p">
    <button type="button" class="link" data-action="nested#remove">
      <%= t(".remove") %>
    </button>
  </div>
</div>
