<% if @steps.any? && can?(:format_all, Step) %>
  <div class="p p--flex">
    <%= render(
      "shared/confirm",
      url: [:format_all, *index_url],
      text: t(".format_all"),
      method: :post
    ) %>
  </div>
<% end %>

<% if can?(:create, model_class) %>
  <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @steps.any? %>
    <div class="p p--flex">
      <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
    </div>
  <% end %>

  <%= render_collection(partial: "steps/step", collection: @steps, as: :step) %>
</turbo-frame>
