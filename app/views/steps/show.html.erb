<% content_for(:title, @step) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@step) %>

<%= render("shared/attribute", label: t(".id"), value: @step.id) %>

<%= render(
  "shared/attribute",
  label: t(".service_id"),
  value: @step.service,
  type: :record
) %>

<% %i[name_en name_fr description_en description_fr body_en body_fr].each do |attribute| %>
  <%= render(
    "shared/attribute",
    label: t(".#{attribute}"),
    value: @step.public_send(attribute),
    type: :content
  ) %>
<% end %>

<%= render("shared/attribute", label: t(".position"), value: @step.position) %>

<%= render(
  "shared/attribute",
  label: t(".input"),
  value: @step.input,
  type: :code,
  url: can?(:update, @step) ? edit_url : nil
) %>

<%= render(
  "shared/attribute",
  label: t(".offset_seconds"),
  value: @step.offset_seconds
) %>

<%= render(
  "shared/attribute",
  label: t(".updated_at"),
  value: @step.updated_at,
  type: :time
) %>

<%= render(
  "shared/attribute",
  label: t(".created_at"),
  value: @step.created_at,
  type: :time
) %>

<% if can?(:update, @step) %>
  <div class="p p--flex">
    <%= link_to(t(".edit"), edit_url, class: :link) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  </div>
<% end %>

<div class="p font-bold">
  <%= link_to(
    t(".step_executions"),
    step_executions_path(step_id: @step.id),
    class: :link
  ) %>
</div>
<% if can?(:create, StepExecution) %>
  <div class="p">
    <%= link_to(
      t(".new_step_execution"),
      new_step_execution_path(step_execution: { step_id: @step.id }),
      class: "button"
    ) %>
  </div>
<% end %>
<%= render_collection(
  partial: "step_executions/step_execution",
  collection: @step_executions,
  as: :step_execution
) %>

<% if can?(:index, Version) %>
  <div class="p font-bold"><%= t(".versions") %></div>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: []
    }
  ) %>
<% end %>

<% if can?(:index, Log) %>
  <div class="p font-bold"><%= t(".logs") %></div>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: []
    }
  ) %>
<% end %>
<% if can?(:format, @step) %>
  <div class="p">
    <%= render(
      "shared/confirm",
      url: [:format, *show_url],
      text: t(".format"),
      method: :post
    ) %>
  </div>
<% end %>
