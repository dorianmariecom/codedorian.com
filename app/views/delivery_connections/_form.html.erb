<%= form_with model: delivery_connection do |f| %>
  <div class="p">
    <%= f.label :user_id, class: :label %>
    <%= f.select :user_id, user_options(user_id: f.object.user_id), {}, class: :input %>
  </div>
  <div class="p">
    <%= f.label :name, class: :label %>
    <%= f.text_field :name, class: :input %>
  </div>
  <div class="p">
    <%= f.label :provider, class: :label %>
    <%= f.select :provider,
             delivery_connection_provider_options(provider: f.object.provider),
             {},
             class: :input %>
  </div>
  <div class="p">
    <%= f.label :enabled, class: :label %>
    <%= f.check_box :enabled, class: :input %>
  </div>
  <div class="p">
    <%= f.label :access_token, class: :label %>
    <%= f.text_field :access_token, class: :input %>
  </div>
  <div class="p">
    <%= f.label :base_url, class: :label %>
    <%= f.text_field :base_url, class: :input %>
  </div>
  <div class="p">
    <%= f.label :account_sid, class: :label %>
    <%= f.text_field :account_sid, class: :input %>
  </div>
  <div class="p">
    <%= f.label :auth_token, class: :label %>
    <%= f.text_field :auth_token, class: :input %>
  </div>
  <div class="p">
    <%= f.label :api_key, class: :label %>
    <%= f.text_field :api_key, class: :input %>
  </div>
  <div class="p">
    <%= f.label :sender, class: :label %>
    <%= f.text_field :sender, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_from, class: :label %>
    <%= f.text_field :smtp_from, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_address, class: :label %>
    <%= f.text_field :smtp_address, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_port, class: :label %>
    <%= f.number_field :smtp_port, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_user_name, class: :label %>
    <%= f.text_field :smtp_user_name, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_password, class: :label %>
    <%= f.text_field :smtp_password, class: :input %>
  </div>
  <div class="p">
    <%= f.label :smtp_authentication, class: :label %>
    <%= f.text_field :smtp_authentication, class: :input %>
  </div>
  <div class="p">
    <%= f.submit submit,
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: submit
             } %>
  </div>
<% end %>
