<% content_for :description, t(".manage") %>
<% content_for :title, t(".manage") %>
<%= form_with model: delivery_connection do |f| %>
  <% if admin? %>
    <div class="p">
      <%= f.label :user_id, class: :label %>
      <%= f.select :user_id,
               policy_scope(User).order(:id).map { |user| [user.to_s, user.id] },
               {},
               class: :input %>
    </div>
  <% end %>
  <% delivery_connection.errors.full_messages.each do |message| %>
    <div class="p text-red-600"><%= message %></div>
  <% end %>
  <div class="p">
    <%= f.label :name, t(".name"), class: :label %>
    <%= f.text_field :name, required: true, class: :input %>
  </div>
  <div class="p">
    <%= f.label :provider, t(".provider"), class: :label %>
    <%= f.select :provider, DeliveryConnection::PROVIDERS, {}, class: :input %>
  </div>
  <p class="p"><%= t(".connection_help") %></p>
  <% %w[access_token base_url account_sid auth_token api_key sender from].each do |key| %>
    <div class="p">
      <%= label_tag "connection_#{key}", t(".credentials.#{key}"), class: :label %>
      <%= password_field_tag "delivery_connection[credentials][#{key}]",
                         nil,
                         id: "connection_#{key}",
                         autocomplete: "new-password",
                         class: :input %>
    </div>
  <% end %>
  <% if admin? %>
    <fieldset class="p">
      <legend>SMTP</legend>
      <% %w[address port user_name password authentication].each do |key| %>
        <div class="p">
          <%= label_tag "smtp_#{key}", key.humanize, class: :label %>
          <%= password_field_tag "delivery_connection[credentials][smtp_settings][#{key}]",
                             nil,
                             id: "smtp_#{key}",
                             autocomplete: "new-password",
                             class: :input %>
        </div>
      <% end %>
    </fieldset>
  <% end %>
  <div class="p">
    <%= f.check_box :enabled %><%= f.label :enabled, t(".enabled") %>
  </div>
  <div class="p">
    <%= f.submit t(".save"),
             class: :button,
             data: {
               controller: "bridge--button",
               bridge__button_title_value: t(".save")
             } %>
  </div>
<% end %>
