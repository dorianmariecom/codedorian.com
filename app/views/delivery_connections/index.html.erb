<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_connections) %>
<% if can?(:create, DeliveryConnection) %>
  <% if can?(:create, model_class) %>
    <div class="p"><%= link_to(t(".new"), new_url, class: "button") %></div>
  <% end %>
<% end %>
<% DeliveryConnectionOauth::PROVIDERS.each do |provider| %>
  <% if can?(:connect, DeliveryConnection.new(user: current_user, provider: provider)) %>
    <%= form_with url: connect_delivery_connections_path(provider: provider),
              data: {
                turbo: false
              },
              class: :p do |f| %>
      <% if provider == "mastodon" %>
        <%= f.label :server, t(".server"), class: :label %>
        <%= f.url_field :server, required: true, class: :input %>
      <% end %>
      <% if provider == "google" %>
        <div>
          <%= f.check_box :scope,
                      { id: "#{provider}_calendar_access", checked: false },
                      MailboxOauth::GOOGLE_CALENDAR_SCOPES.join(" "),
                      "" %>
          <%= f.label :scope, t(".calendar_access"), for: "#{provider}_calendar_access" %>
          <div class="p"><%= t(".calendar_access_description") %></div>
        </div>
      <% end %>
      <%= f.submit t(
                 ".connect",
                 provider: t("delivery_connections.model.providers.#{provider}")
               ),
               class: :button %>
    <% end %>
  <% end %>
<% end %>
<%= render("shared/search") %>

<turbo-frame id="search" target="_top">
  <% if @delivery_connections.any? %>
    <div class="p p--flex">
      <% if can?(:destroy_all, DeliveryConnection) %>
        <%= render("shared/confirm", url: destroy_all_url, text: t(".destroy_all")) %>
      <% end %>
      <% if can?(:delete_all, DeliveryConnection) %>
        <%= render("shared/confirm", url: delete_all_url, text: t(".delete_all")) %>
      <% end %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "delivery_connections/delivery_connection",
    collection: @delivery_connections,
    as: :delivery_connection
  ) %>
</turbo-frame>
