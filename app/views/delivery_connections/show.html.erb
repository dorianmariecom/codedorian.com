<% content_for(:title, @delivery_connection) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_connection) %>
<% if can?(:show, @delivery_connection) %>
  <%= render("shared/attribute", label: t(".id"), value: @delivery_connection.id) %>
  <%= render(
    "shared/attribute",
    label: t(".user_id"),
    value: @delivery_connection.user_id
  ) %>
  <%= render("shared/attribute", label: t(".name"), value: @delivery_connection.name) %>
  <%= render(
    "shared/attribute",
    label: t(".provider"),
    value: @delivery_connection.provider
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".enabled"),
    value: @delivery_connection.enabled
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".access_token"),
    value: @delivery_connection.access_token
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".base_url"),
    value: @delivery_connection.base_url
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".account_sid"),
    value: @delivery_connection.account_sid
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".auth_token"),
    value: @delivery_connection.auth_token
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".api_key"),
    value: @delivery_connection.api_key
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".sender"),
    value: @delivery_connection.sender
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_from"),
    value: @delivery_connection.smtp_from
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_address"),
    value: @delivery_connection.smtp_address
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_port"),
    value: @delivery_connection.smtp_port
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_user_name"),
    value: @delivery_connection.smtp_user_name
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_password"),
    value: @delivery_connection.smtp_password
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".smtp_authentication"),
    value: @delivery_connection.smtp_authentication
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".refresh_token"),
    value: @delivery_connection.refresh_token
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".token_expires_at"),
    value: @delivery_connection.token_expires_at
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".aws_access_key_id"),
    value: @delivery_connection.aws_access_key_id
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".aws_secret_access_key"),
    value: @delivery_connection.aws_secret_access_key
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".aws_session_token"),
    value: @delivery_connection.aws_session_token
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".aws_region"),
    value: @delivery_connection.aws_region
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".mailgun_domain"),
    value: @delivery_connection.mailgun_domain
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".mailgun_region"),
    value: @delivery_connection.mailgun_region
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".created_at"),
    value: @delivery_connection.created_at,
    type: :time
  ) %>
  <%= render(
    "shared/attribute",
    label: t(".updated_at"),
    value: @delivery_connection.updated_at,
    type: :time
  ) %>
<% else %>
  <div class="p"><%= @delivery_connection %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_connection) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_connection) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_connection) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_connection_id: @delivery_connection.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_connection_id: @delivery_connection.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_connection]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_connection_id: @delivery_connection.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_connection_id: @delivery_connection.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_connection]
    }
  ) %>
<% end %>
