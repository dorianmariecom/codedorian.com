<% content_for(:title, @delivery_connection) %>
<% content_for(:description, t(".description")) %>
<%= turbo_stream_from(@delivery_connection) %>
<% if can?(:show, @delivery_connection) %>
  <div class="p">
    <div class="text-gray-600"><%= t(".id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".user_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.user_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".name") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.name %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".provider") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.provider %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".enabled") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.enabled %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".access_token") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.access_token %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".base_url") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.base_url %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".account_sid") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.account_sid %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".auth_token") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.auth_token %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".api_key") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.api_key %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".sender") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.sender %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_from") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_from %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_address") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_address %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_port") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_port %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_user_name") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_user_name %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_password") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_password %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".smtp_authentication") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.smtp_authentication %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".refresh_token") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.refresh_token %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".token_expires_at") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.token_expires_at %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".aws_access_key_id") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.aws_access_key_id %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".aws_secret_access_key") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.aws_secret_access_key %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".aws_session_token") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.aws_session_token %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".aws_region") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.aws_region %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".mailgun_domain") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.mailgun_domain %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".mailgun_region") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.mailgun_region %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".created_at") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.created_at %>
    </div>
  </div>
  <div class="p">
    <div class="text-gray-600"><%= t(".updated_at") %></div>
    <div class="font-bold whitespace-pre-wrap">
      <%= @delivery_connection.updated_at %>
    </div>
  </div>
<% else %>
  <div class="p"><%= @delivery_connection %></div>
<% end %>
<div class="p p--flex">
  <% if can?(:update, @delivery_connection) %>
    <%= link_to(t(".edit"), edit_url, class: :link) %>
  <% end %>
  <% if can?(:destroy, @delivery_connection) %>
    <%= render("shared/confirm", text: t(".destroy"), url: destroy_url) %>
  <% end %>
  <% if can?(:delete, @delivery_connection) %>
    <%= render("shared/confirm", text: t(".delete"), url: delete_url) %>
  <% end %>
</div>
<% if can?(:index, Version) %>
  <div class="p font-bold">
    <%= link_to t(".versions"),
            {
              controller: :versions,
              action: :index,
              delivery_connection_id: @delivery_connection.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Version) %>
    <div class="p">
      <%= link_to t(".new_version"),
              {
                controller: :versions,
                action: :new,
                delivery_connection_id: @delivery_connection.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "versions/version",
    collection: @versions,
    as: :version,
    locals: {
      nested: [*nested, @delivery_connection]
    }
  ) %>
<% end %>
<% if can?(:index, Log) %>
  <div class="p font-bold">
    <%= link_to t(".logs"),
            {
              controller: :logs,
              action: :index,
              delivery_connection_id: @delivery_connection.id
            },
            class: :link %>
  </div>
  <% if can?(:create, Log) %>
    <div class="p">
      <%= link_to t(".new_log"),
              {
                controller: :logs,
                action: :new,
                delivery_connection_id: @delivery_connection.id
              },
              class: :button %>
    </div>
  <% end %>
  <%= render_collection(
    partial: "logs/log",
    collection: @logs,
    as: :log,
    locals: {
      nested: [*nested, @delivery_connection]
    }
  ) %>
<% end %>
